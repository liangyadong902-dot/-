/* overlay uses app.wxss via apply-shared */

/* 全局消息横幅 */
.msg-banner {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 16rpx);
  left: 24rpx;
  right: 24rpx;
  z-index: 12000;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 12rpx 48rpx rgba(40, 36, 24, 0.18);
  animation: mb-drop 0.28s ease-out;
}
@keyframes mb-drop {
  from { transform: translateY(-140%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
.mb-ic { width: 68rpx; height: 68rpx; border-radius: 50%; flex-shrink: 0; position: relative; overflow: hidden; }
.mb-ava { position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: 50%; }
.mb-ic.ic-dm { background: #E8F0DC; }
.mb-ic.ic-dm::after {
  content: '';
  position: absolute;
  left: 50%; top: 50%;
  width: 30rpx; height: 24rpx;
  transform: translate(-50%, -50%);
  background: #6C7E58;
  border-radius: 12rpx 12rpx 12rpx 4rpx;
}
.mb-ic.ic-notice { background: #FDEBEC; }
.mb-ic.ic-notice::after {
  content: '';
  position: absolute;
  left: 50%; top: 50%;
  width: 26rpx; height: 24rpx;
  transform: translate(-50%, -52%) rotate(45deg);
  background: #E05A5E;
  border-radius: 4rpx 10rpx 4rpx 10rpx;
}
.mb-main { flex: 1; min-width: 0; margin: 0 18rpx; }
.mb-title { font-size: 27rpx; font-weight: 800; color: #2A3322; line-height: 1.3; }
.mb-desc { margin-top: 4rpx; font-size: 23rpx; color: #8A8375; line-height: 1.35; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mb-close { flex-shrink: 0; padding: 8rpx 8rpx 8rpx 16rpx; font-size: 34rpx; color: #C9C2B2; line-height: 1; }
