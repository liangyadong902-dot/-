/* AI 搭子：对照 docs/页面原型.html #tab-ai，390px → 750rpx */

page {
  height: 100%;
  overflow: hidden;
}

.page-ai.tab-view {
  height: 100%;
  min-height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  background: var(--cream);
  box-sizing: border-box;
  padding-bottom: 0;
}

.page-ai .ai-stage {
  flex: 1;
  min-height: 0;
  height: auto;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page-ai .cloud-head.ai-cloud {
  position: relative;
  padding: 96.15rpx 30.77rpx 53.85rpx 34.62rpx;
  flex-shrink: 0;
  overflow: visible;
  z-index: 2;
}

/* 返回按钮：AI页已从 tab 改为二级页 */
.page-ai .ai-back {
  position: absolute;
  top: 88rpx;
  left: 20rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.92);
  box-shadow: 0 2rpx 10rpx rgba(76, 89, 62, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 44rpx;
  color: #4C593E;
  z-index: 9;
}

.page-ai .ai-hero {
  display: flex;
  align-items: center;
  gap: 23.08rpx;
  position: relative;
  z-index: 1;
}

.page-ai .ai-hero-dog {
  width: 146.15rpx;
  height: 146.15rpx;
  flex-shrink: 0;
  background: var(--paper);
  border: 2.69rpx solid var(--ink);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 3.85rpx 3.85rpx 0 rgba(60, 52, 44, 0.06);
  overflow: hidden;
}

.page-ai .ai-hero-dog-img {
  width: 130.77rpx;
  height: 130.77rpx;
  display: block;
}

.page-ai .ai-hero-copy {
  flex: 1;
  min-width: 0;
}

.page-ai .ai-hero-copy .speech {
  margin-bottom: 11.54rpx;
  white-space: normal;
  line-height: 1.4;
  max-width: 100%;
}

.page-ai .ai-name {
  font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
  font-size: 38.46rpx;
  font-weight: 900;
  letter-spacing: 0.04em;
  line-height: 1.1;
}

.page-ai .ai-sub {
  margin-top: 7.69rpx;
  font-size: 21.15rpx;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 11.54rpx;
  font-weight: 500;
}

.page-ai .online-dot {
  width: 13.46rpx;
  height: 13.46rpx;
  border-radius: 50%;
  background: var(--sage);
  box-shadow: 0 0 0 5.77rpx rgba(142, 164, 124, 0.28);
  flex-shrink: 0;
}

.page-ai .ai-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.page-ai .ai-history {
  flex: 0 0 242.31rpx;
  width: 242.31rpx;
  min-height: 0;
  overflow: hidden;
  padding: 15.38rpx 11.54rpx 19.23rpx 19.23rpx;
  border-right: 1.92rpx dashed var(--line);
  background: linear-gradient(90deg, #E8F0DC 0%, rgba(232, 240, 220, 0) 88%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  transition: flex-basis 0.28s cubic-bezier(.22,1,.36,1), width 0.28s cubic-bezier(.22,1,.36,1), padding 0.28s ease;
}

.page-ai .ai-body.hist-collapsed .ai-history {
  flex: 0 0 69.23rpx;
  width: 69.23rpx;
  padding: 15.38rpx 7.69rpx 19.23rpx;
}

.page-ai .ai-hist-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 3.85rpx;
  min-height: 46.15rpx;
  margin-bottom: 15.38rpx;
  flex-shrink: 0;
}

.page-ai .ai-body.hist-collapsed .ai-hist-head {
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  margin-bottom: 0;
}

.page-ai .ai-body.hist-collapsed .ai-hist-toggle {
  order: -1;
}

.page-ai .ai-hist-label {
  font-size: 17.31rpx;
  letter-spacing: 0.16em;
  color: var(--sage-deep);
  font-weight: 700;
  white-space: nowrap;
}

.page-ai .ai-body.hist-collapsed .ai-hist-label {
  writing-mode: vertical-rl;
  letter-spacing: 0.22em;
  margin-top: 15.38rpx;
  line-height: 1.4;
}

.page-ai .ai-hist-toggle {
  width: 42.31rpx;
  height: 42.31rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 2.5rpx solid var(--ink);
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 1.92rpx 1.92rpx 0 rgba(60, 52, 44, 0.06);
  padding: 0;
}

.page-ai .ai-hist-chevron {
  width: 19.23rpx;
  height: 19.23rpx;
  display: block;
  transition: transform 0.28s cubic-bezier(.22,1,.36,1);
}

.page-ai .ai-body.hist-collapsed .ai-hist-chevron {
  transform: rotate(180deg);
}

.page-ai .ai-hist-panel {
  flex: 1;
  height: 0;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
}

.page-ai .ai-hist-panel::-webkit-scrollbar { display: none; }

.page-ai .ai-body.hist-collapsed .ai-hist-panel {
  opacity: 0;
  visibility: hidden;
  height: 0;
  max-height: 0;
  overflow: hidden;
  pointer-events: none;
}

.page-ai .ai-hist-new {
  width: 100%;
  height: 57.69rpx;
  border-radius: 1921.15rpx;
  border: 2.5rpx dashed var(--sage);
  background: var(--paper);
  color: var(--sage-deep);
  font-size: 21.15rpx;
  font-weight: 700;
  margin-bottom: 15.38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.page-ai .ai-hist-item {
  width: 100%;
  text-align: left;
  background: var(--paper);
  border: 2.5rpx solid transparent;
  border-radius: 23.08rpx;
  padding: 15.38rpx 15.38rpx 13.46rpx;
  margin-bottom: 11.54rpx;
  box-shadow: 0 5.77rpx 19.23rpx rgba(60, 52, 44, 0.04);
  box-sizing: border-box;
}

.page-ai .ai-hist-item.on {
  background: var(--sage-mist);
  border-color: var(--ink);
  box-shadow: 3.85rpx 3.85rpx 0 rgba(60, 52, 44, 0.05);
}

.page-ai .ai-hist-item .b {
  display: block;
  font-size: 21.15rpx;
  font-weight: 800;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.page-ai .ai-hist-item .small {
  display: block;
  font-size: 17.31rpx;
  color: var(--muted);
  margin-top: 5.77rpx;
}

.page-ai .ai-chat-col {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
}

.page-ai .chat-scroll-area {
  flex-shrink: 0;
  overflow: hidden;
  padding: 0;
  display: block;
}

.page-ai .chat-inner {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 23.08rpx;
  padding: 34.62rpx 30.77rpx 15.38rpx;
  box-sizing: border-box;
  width: 100%;
}

.page-ai .chat-end {
  height: 2rpx;
  width: 100%;
}

.page-ai .chat-row {
  display: flex;
  gap: 15.38rpx;
  max-width: 88%;
  align-items: flex-start;
}

.page-ai .chat-row.bot {
  align-self: flex-start;
}

.page-ai .chat-row.user {
  align-self: flex-end;
  max-width: 76%;
  justify-content: flex-end;
}

.page-ai .bot-ava {
  width: 53.85rpx;
  height: 53.85rpx;
  border-radius: 50%;
  background: var(--paper);
  border: 2.5rpx solid var(--ink);
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 3.85rpx;
}

.page-ai .bot-ava-img {
  width: 42.31rpx;
  height: 42.31rpx;
  display: block;
}

.page-ai .chat-col {
  display: flex;
  flex-direction: column;
  gap: 15.38rpx;
  min-width: 0;
}

.page-ai .chat-bubble-box {
  padding: 19.23rpx 26.92rpx;
  border-radius: 30.77rpx;
  font-size: 25rpx;
  line-height: 1.55;
}

.page-ai .chat-row.bot .chat-bubble-box {
  background: var(--paper);
  border: 2.5rpx solid var(--ink);
  border-bottom-left-radius: 7.69rpx;
  box-shadow: 3.85rpx 3.85rpx 0 rgba(60, 52, 44, 0.05);
}

.page-ai .chat-row.user .chat-bubble-box {
  background: var(--sage);
  color: #fff;
  border-bottom-right-radius: 7.69rpx;
}

.page-ai .markdown-body {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.page-ai .markdown-body .md-p {
  display: block;
  margin: 0 0 15.38rpx;
}

.page-ai .markdown-body .md-p:last-child,
.page-ai .markdown-body .md-list:last-child,
.page-ai .markdown-body .md-quote:last-child,
.page-ai .markdown-body .md-pre:last-child,
.page-ai .markdown-body .md-table:last-child {
  margin-bottom: 0;
}

.page-ai .markdown-body .md-heading {
  display: block;
  margin: 7.69rpx 0 11.54rpx;
  color: var(--ink);
  font-weight: 800;
  line-height: 1.35;
}

.page-ai .markdown-body .md-h1,
.page-ai .markdown-body .md-h2 {
  font-size: 30.77rpx;
}

.page-ai .markdown-body .md-h3,
.page-ai .markdown-body .md-h4,
.page-ai .markdown-body .md-h5,
.page-ai .markdown-body .md-h6 {
  font-size: 26.92rpx;
}

.page-ai .markdown-body .md-strong {
  font-weight: 800;
  color: var(--ink);
}

.page-ai .markdown-body .md-em {
  font-style: italic;
}

.page-ai .markdown-body .md-del {
  text-decoration: line-through;
  color: var(--muted);
}

.page-ai .markdown-body .md-list {
  display: block;
  margin: 7.69rpx 0 15.38rpx 34.62rpx;
  padding-left: 19.23rpx;
}

.page-ai .markdown-body .md-li {
  display: list-item;
  margin: 5.77rpx 0;
}

.page-ai .markdown-body .md-quote {
  display: block;
  margin: 11.54rpx 0 15.38rpx;
  padding: 9.62rpx 15.38rpx;
  border-left: 5.77rpx solid var(--sage);
  background: rgba(144, 166, 135, 0.1);
  color: var(--muted);
}

.page-ai .markdown-body .md-inline-code {
  padding: 1.92rpx 7.69rpx;
  border-radius: 5.77rpx;
  background: #eee9df;
  color: #8a4e36;
  font-family: monospace;
  font-size: 23.08rpx;
}

.page-ai .markdown-body .md-pre {
  display: block;
  max-width: 100%;
  margin: 11.54rpx 0 15.38rpx;
  padding: 15.38rpx;
  overflow-x: auto;
  border-radius: 7.69rpx;
  background: #302d2a;
  color: #f8f4eb;
  white-space: pre-wrap;
  box-sizing: border-box;
}

.page-ai .markdown-body .md-code {
  font-family: monospace;
  font-size: 21.15rpx;
  line-height: 1.55;
}

.page-ai .markdown-body .md-link {
  color: var(--sage-deep);
  text-decoration: underline;
}

.page-ai .markdown-body .md-hr {
  display: block;
  height: 2rpx;
  margin: 15.38rpx 0;
  border: 0;
  background: var(--line);
}

.page-ai .markdown-body .md-table {
  display: table;
  width: 100%;
  margin: 11.54rpx 0 15.38rpx;
  border-collapse: collapse;
  font-size: 21.15rpx;
}

.page-ai .markdown-body .md-th,
.page-ai .markdown-body .md-td {
  padding: 7.69rpx;
  border: 1.92rpx solid var(--line);
  text-align: left;
  vertical-align: top;
}

.page-ai .markdown-body .md-th {
  background: #eee9df;
  color: var(--ink);
  font-weight: 800;
}

.page-ai .typing-dots {
  display: flex;
  gap: 7.69rpx;
  align-items: center;
  min-width: 80.77rpx;
  height: 30.77rpx;
}

.page-ai .typing-dots .dot {
  width: 11.54rpx;
  height: 11.54rpx;
  border-radius: 50%;
  background: var(--sage);
  opacity: 0.35;
  animation: typingPulse 1s ease-in-out infinite;
}

.page-ai .typing-dots .dot:nth-child(2) { animation-delay: 0.15s; }
.page-ai .typing-dots .dot:nth-child(3) { animation-delay: 0.3s; }

@keyframes typingPulse {
  0%, 80%, 100% { opacity: 0.3; transform: translateY(0); }
  40% { opacity: 1; transform: translateY(-3.85rpx); }
}

.page-ai .rec-card {
  display: flex;
  gap: 19.23rpx;
  background: var(--paper);
  border-radius: 30.77rpx;
  overflow: hidden;
  box-shadow: 0 7.69rpx 26.92rpx rgba(60, 52, 44, 0.06);
  width: 453.85rpx;
}

.page-ai .rec-thumb {
  width: 150rpx;
  height: 165.38rpx;
  flex-shrink: 0;
  display: block;
}

.page-ai .rec-info {
  padding: 15.38rpx 19.23rpx 15.38rpx 0;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.page-ai .rec-name {
  font-size: 23.08rpx;
  font-weight: 800;
  line-height: 1.3;
}

.page-ai .rec-meta {
  font-size: 19.23rpx;
  color: var(--sage-deep);
  margin: 7.69rpx 0 11.54rpx;
  font-weight: 700;
}

.page-ai .rec-cta {
  color: var(--sage-deep);
  font-size: 23.08rpx;
  font-weight: 700;
  padding: 0;
  display: inline-flex;
  align-items: center;
  gap: 3.85rpx;
}

.page-ai .ai-dock {
  flex-shrink: 0;
  min-height: 168rpx;
  padding: 11.54rpx 30.77rpx 19.23rpx;
  background: linear-gradient(180deg, rgba(246, 241, 230, 0) 0%, var(--cream) 19.23rpx);
  position: relative;
  z-index: 2;
}

.page-ai .ai-quick {
  display: flex;
  flex-direction: row;
  gap: 15.38rpx;
  padding-bottom: 15.38rpx;
  /* Keep the prototype's horizontally scrollable prompt rail.  Hiding
     overflow clipped the third prompt on narrow phones. */
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
}

.page-ai .ai-quick::-webkit-scrollbar { display: none; }

.page-ai .ai-quick .mood-chip {
  flex-shrink: 0;
  font-size: 19.23rpx;
  color: var(--muted);
  background: var(--cream-2);
  padding: 9.62rpx 19.23rpx;
  border-radius: 1921.15rpx;
  white-space: nowrap;
  font-weight: 500;
}

.page-ai .ai-compose {
  display: flex;
  gap: 15.38rpx;
  align-items: center;
}

.page-ai .ai-input-wrap {
  flex: 1;
  min-width: 0;
  height: 80.77rpx;
  border-radius: 1921.15rpx;
  background: var(--paper);
  box-shadow: 0 5.77rpx 23.08rpx rgba(60, 52, 44, 0.05);
  display: flex;
  align-items: center;
  padding: 0 30.77rpx;
  box-sizing: border-box;
}

.page-ai .ai-input-wrap input {
  flex: 1;
  width: 100%;
  height: 80.77rpx;
  min-height: 0;
  border: none;
  background: transparent;
  box-shadow: none;
  padding: 0;
  border-radius: 0;
  font-size: 23.08rpx;
  font-family: inherit;
  color: var(--ink);
}

.page-ai .ai-compose .btn-search {
  height: 80.77rpx;
  padding: 0 30.77rpx;
  flex-shrink: 0;
}

.page-ai .ai-compose .btn-search.is-off {
  opacity: 0.55;
}
