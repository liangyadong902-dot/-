<view class="achievement-detail"><view wx:if="{{loading}}" class="state">正在读取成就…</view><view wx:elif="{{error}}" class="state">{{error}}</view><view wx:elif="{{item}}" class="achievement-detail-body"><view class="hero-icon"><image wx:if="{{item.iconUrl}}" src="{{item.iconUrl}}" mode="aspectFit"/><text wx:else>{{item.level}}</text></view><view class="detail-name">{{item.name}}</view><view class="detail-state">{{item.state==='unlocked'?'已解锁':item.state==='in_progress'?'进行中':'尚未开始'}}</view><view class="detail-description">{{item.description}}</view><view class="big-progress"><view class="big-value" style="width:{{item.progressPercent}}%"></view></view><view class="detail-count">{{item.currentProgress}} / {{item.requirementValue}}</view><view wx:if="{{item.unlockedAt}}" class="unlocked-at">解锁于 {{item.unlockedAt}}</view></view></view>
