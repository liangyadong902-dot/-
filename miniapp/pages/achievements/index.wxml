<view class="achievement-page"><view class="achievement-head"><view class="kicker">BEHAVIOR ACHIEVEMENTS</view><view class="title">行为成就</view><view class="desc">每一次出发，都会留下新的进度。</view><button bindtap="check">刷新进度</button></view><view wx:if="{{loading}}" class="state">正在同步成就进度…</view><view wx:elif="{{error}}" class="state">{{error}}<button bindtap="load">重试</button></view><view wx:elif="{{!list.length}}" class="state">还没有可展示的成就</view><view wx:else class="achievement-list"><view wx:for="{{list}}" wx:key="code" class="achievement-item {{item.state==='unlocked'?'unlocked':''}}" data-code="{{item.code}}" bindtap="openDetail"><view class="icon"><image wx:if="{{item.iconUrl}}" src="{{item.iconUrl}}" mode="aspectFit"/><text wx:else>{{item.level}}</text></view><view class="achievement-copy"><view class="achievement-name">{{item.name}}<text wx:if="{{item.state==='unlocked'}}">已解锁</text></view><view class="achievement-desc">{{item.description}}</view><view class="progress-track"><view class="progress-value" style="width:{{item.progressPercent}}%"></view></view><view class="progress-label">{{item.currentProgress}} / {{item.requirementValue}}</view></view><view class="arrow">›</view></view></view></view>

<tuge-overlay />
