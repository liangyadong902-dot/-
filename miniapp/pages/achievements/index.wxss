.achievement-page{min-height:100vh;background:var(--cream)}.achievement-head{position:relative;padding:72rpx 34rpx 42rpx;background:linear-gradient(180deg,#e3edd6,var(--cream))}.kicker{color:var(--sage-deep);letter-spacing:.16em;font-size:18rpx}.title{margin-top:14rpx;font-family:serif;font-size:44rpx;font-weight:900}.desc{margin-top:12rpx;color:var(--muted);font-size:21rpx}.achievement-head button{position:absolute;right:34rpx;bottom:42rpx;margin:0;padding:8rpx 18rpx;border:1rpx solid var(--sage);border-radius:999rpx;background:var(--paper);color:var(--sage-deep);font-size:19rpx}.state{min-height:50vh;display:grid;place-items:center;color:var(--muted);font-size:23rpx}.achievement-list{padding:22rpx 34rpx}.achievement-item{display:flex;align-items:center;gap:18rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line)}.icon{width:82rpx;height:82rpx;flex-shrink:0;border-radius:50%;display:grid;place-items:center;background:var(--cream-2);color:var(--muted);font-family:serif;font-size:30rpx}.unlocked .icon{background:var(--sage);color:#fff}.icon image{width:58rpx;height:58rpx}.achievement-copy{flex:1;min-width:0}.achievement-name{font-size:26rpx;font-weight:800}.achievement-name text{margin-left:10rpx;padding:4rpx 10rpx;border-radius:6rpx;background:var(--sage-mist);color:var(--sage-deep);font-size:16rpx;font-weight:500}.achievement-desc{margin-top:7rpx;color:var(--muted);font-size:20rpx}.progress-track{height:10rpx;margin-top:14rpx;background:var(--cream-2);border-radius:999rpx;overflow:hidden}.progress-value{height:100%;background:var(--sage);border-radius:999rpx}.progress-label{margin-top:6rpx;color:var(--sage-deep);font-size:18rpx}.arrow{color:var(--muted);font-size:36rpx}
