.achievement-detail{min-height:100vh;background:var(--cream)}.state{min-height:70vh;display:grid;place-items:center;color:var(--muted);font-size:23rpx}.achievement-detail-body{padding:90rpx 50rpx;text-align:center}.hero-icon{width:170rpx;height:170rpx;margin:0 auto;border-radius:50%;display:grid;place-items:center;background:var(--sage-deep);color:#fff;font-family:serif;font-size:60rpx;box-shadow:0 18rpx 36rpx rgba(108,126,88,.25)}.hero-icon image{width:110rpx;height:110rpx}.detail-name{margin-top:28rpx;font-family:serif;font-size:44rpx;font-weight:900}.detail-state{display:inline-block;margin-top:14rpx;padding:8rpx 18rpx;border-radius:999rpx;background:var(--sage-mist);color:var(--sage-deep);font-size:20rpx}.detail-description{margin-top:40rpx;color:var(--muted);font-size:24rpx;line-height:1.7}.big-progress{height:18rpx;margin-top:50rpx;background:var(--cream-2);border-radius:999rpx;overflow:hidden}.big-value{height:100%;background:var(--sage);border-radius:999rpx}.detail-count{margin-top:12rpx;color:var(--sage-deep);font-size:21rpx}.unlocked-at{margin-top:24rpx;color:var(--muted);font-size:20rpx}
