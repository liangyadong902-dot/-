.rank-page{min-height:100vh;background:var(--cream);padding-bottom:60rpx}.rank-head{padding:88rpx 34rpx 38rpx;background:linear-gradient(180deg,#e3edd6,var(--cream))}.kicker{display:block;color:var(--sage-deep);font-size:18rpx;letter-spacing:.16em}.title{display:block;margin-top:12rpx;font:900 46rpx/1.2 serif}.desc{display:block;margin-top:10rpx;color:var(--muted);font-size:21rpx}.tabs{display:flex;gap:12rpx;padding:20rpx 28rpx}.tab{padding:10rpx 20rpx;border:1rpx solid var(--line);border-radius:999rpx;background:var(--paper);font-size:20rpx;color:var(--muted)}.tab.active{background:var(--sage-mist);border-color:var(--sage);color:var(--sage-deep)}.list{padding:0 28rpx}.creator{display:flex;align-items:center;gap:16rpx;padding:20rpx 0;border-bottom:1rpx solid var(--line)}.rank{width:42rpx;color:var(--sage-deep);font:800 26rpx serif}.creator image{width:76rpx;height:76rpx;border-radius:50%;background:var(--sage-mist)}.copy{flex:1;min-width:0}.name,.meta{display:block}.name{font-weight:800;font-size:24rpx}.meta{margin-top:6rpx;color:var(--muted);font-size:18rpx}.creator button{height:56rpx;padding:0 18rpx;border:1rpx solid var(--sage);border-radius:999rpx;background:var(--paper);color:var(--sage-deep);font-size:19rpx}.state{min-height:45vh;display:grid;place-items:center;color:var(--muted)}
