.fl-page { min-height: 100vh; background: #F6F1E6; padding-bottom: 60rpx; box-sizing: border-box; }
.fl-tabs { display: flex; background: #fff; border-bottom: 2rpx solid #F2EDE2; position: relative; z-index: 5; }
.fl-tab { position: relative; flex: 1; text-align: center; padding: 24rpx 0 20rpx; font-size: 29rpx; color: #8A8375; }
.fl-tab.on { color: #2A3322; font-weight: 800; }
.fl-tab.on::after { content: ''; position: absolute; left: 50%; transform: translateX(-50%); bottom: 8rpx; width: 48rpx; height: 6rpx; border-radius: 3rpx; background: #6C7E58; }

.fl-tip { padding: 120rpx 40rpx; text-align: center; color: #A8A093; font-size: 25rpx; }
.fl-list { padding: 12rpx 24rpx; }
.fl-row { display: flex; align-items: center; justify-content: space-between; background: #fff; border-radius: 20rpx; padding: 20rpx 22rpx; margin-top: 14rpx; }
.fl-user { display: flex; align-items: center; flex: 1; min-width: 0; margin-right: 20rpx; }
.fl-ava { width: 92rpx; height: 92rpx; border-radius: 50%; background: #EFE6D6; flex-shrink: 0; }
.fl-ava-fb { display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 800; color: #6C7E58; }
.fl-main { flex: 1; min-width: 0; margin-left: 20rpx; }
.fl-nick { font-size: 28rpx; font-weight: 700; color: #2A3322; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fl-sub { margin-top: 6rpx; font-size: 21rpx; color: #A8A093; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fl-btn { flex-shrink: 0; padding: 12rpx 30rpx; border-radius: 999rpx; background: #6C7E58; color: #fff; font-size: 24rpx; font-weight: 700; }
.fl-btn.off { background: transparent; border: 2rpx solid #D8D2C4; color: #8A8375; font-weight: 600; }
.fl-more { padding: 24rpx 0 12rpx; text-align: center; color: #B9B2A3; font-size: 22rpx; }
