.collections-page { min-height: 100vh; background: var(--cream); }.collections-head { padding: 72rpx 34rpx 42rpx; background: linear-gradient(180deg,#F7F7F7,var(--cream)); }.kicker { color: var(--sage-deep); letter-spacing: .16em; font-size: 18rpx; }.title { margin-top: 14rpx; font-family: serif; font-size: 44rpx; font-weight: 900; }.desc { margin-top: 10rpx; color: var(--muted); font-size: 22rpx; }.state { min-height: 50vh; padding: 70rpx 34rpx; text-align: center; color: var(--muted); font-size: 23rpx; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }.state button { color: #fff; background: var(--sage); border: 0; border-radius: 999rpx; font-size: 21rpx; }.empty-mark { width: 90rpx; height: 90rpx; border-radius: 50%; background: var(--sage-mist); display: grid; place-items: center; color: var(--sage-deep); font-size: 42rpx; }.muted { font-size: 20rpx; }.saved-list { padding: 24rpx 34rpx; }.saved-item { display: flex; gap: 18rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }.saved-item image { width: 190rpx; height: 150rpx; border-radius: 14rpx; background: var(--cream-2); }.saved-copy { flex: 1; min-width: 0; }.saved-title { font-size: 26rpx; font-weight: 800; line-height: 1.35; }.saved-desc { margin-top: 10rpx; color: var(--muted); font-size: 21rpx; line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }.saved-meta { margin-top: 12rpx; color: var(--sage-deep); font-size: 19rpx; }
