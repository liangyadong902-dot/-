page {
  background: var(--cream);
}

.publish-page {
  min-height: 100vh;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(360rpx 220rpx at 100% 120rpx, rgba(201, 214, 184, 0.42), transparent 72%),
    var(--cream);
}

.publish-nav {
  position: relative;
  z-index: 20;
  background: rgba(227, 237, 214, 0.96);
  border-bottom: 1rpx solid rgba(108, 126, 88, 0.1);
}

.publish-nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
}

.publish-back,
.publish-nav-space {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
}

.publish-back {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(108, 126, 88, 0.2);
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.9);
  box-shadow: 0 6rpx 18rpx rgba(60, 52, 44, 0.06);
}

.publish-back-hover {
  opacity: 0.72;
  transform: scale(0.96);
}

.publish-back-icon {
  margin-top: -2rpx;
  color: var(--ink);
  font-family: Arial, sans-serif;
  font-size: 38rpx;
  font-weight: 400;
  line-height: 1;
}

.publish-nav-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.publish-head {
  padding: 48rpx 36rpx 52rpx;
  background: linear-gradient(180deg, #e3edd6 0%, rgba(228, 237, 216, 0.58) 58%, rgba(246, 241, 230, 0) 100%);
}

.publish-kicker {
  color: var(--sage-deep);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.publish-title {
  max-width: 620rpx;
  margin-top: 16rpx;
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.35;
  letter-spacing: 0.02em;
}

.publish-hint {
  max-width: 610rpx;
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.7;
}

.publish-form {
  padding: 0 28rpx;
}

.publish-card {
  margin-bottom: 22rpx;
  padding: 30rpx 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(231, 220, 206, 0.88);
  border-radius: 24rpx;
  background: var(--paper);
  box-shadow: 0 10rpx 36rpx rgba(60, 52, 44, 0.055);
}

.field {
  margin-bottom: 32rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid var(--line);
}

.field-last {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: 0;
}

.field-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.field-label {
  display: block;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.4;
}

.field-count,
.field-optional {
  flex-shrink: 0;
  color: #aa9e91;
  font-size: 19rpx;
  line-height: 1.5;
}

.field-tip {
  display: block;
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 1.5;
}

.title-input,
.content-input,
.location-input-wrap {
  width: 100%;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: #fbf7ef;
  color: var(--ink);
  font-size: 24rpx;
}

.title-input {
  height: 84rpx;
  padding: 0 22rpx;
}

.content-input {
  height: 240rpx;
  padding: 20rpx 22rpx;
  line-height: 1.65;
}

.field-placeholder {
  color: #b4a99d;
}

.media-card {
  padding-bottom: 28rpx;
}

.media-head {
  margin-bottom: 20rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.upload-image,
.add-image {
  position: relative;
  width: 100%;
  height: 196rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: #f7f1e7;
}

.upload-image image {
  display: block;
  width: 100%;
  height: 100%;
}

.cover-tag {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(60, 52, 44, 0.72);
  color: #fff;
  font-size: 17rpx;
  line-height: 1.4;
}

.remove-image {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 50%;
  background: rgba(60, 52, 44, 0.72);
  color: #fff;
  font-size: 29rpx;
  line-height: 35rpx;
  text-align: center;
}

.add-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-style: dashed;
  border-color: var(--sage-soft);
  background: var(--sage-mist);
  color: var(--sage-deep);
}

.add-icon {
  font-size: 46rpx;
  font-weight: 300;
  line-height: 1;
}

.add-label {
  margin-top: 10rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.topic-scroll {
  width: 100%;
  white-space: nowrap;
}

.topic-list {
  display: inline-flex;
  gap: 12rpx;
  min-width: 100%;
  padding: 2rpx 2rpx 4rpx;
}

.topic-chip {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: #fbf7ef;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 600;
}

.topic-chip.active {
  border-color: var(--sage-deep);
  background: var(--sage-deep);
  color: #fff;
  box-shadow: 0 5rpx 14rpx rgba(108, 126, 88, 0.2);
}

.location-input-wrap {
  height: 84rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.location-mark {
  margin-right: 14rpx;
  color: var(--sage-deep);
  font-size: 28rpx;
  line-height: 1;
}

.location-input {
  min-width: 0;
  height: 100%;
  flex: 1;
  color: var(--ink);
  font-size: 24rpx;
}

.publish-note {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 4rpx 10rpx 0;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.6;
}

.note-mark {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  margin-top: 1rpx;
  border-radius: 50%;
  background: var(--sage-mist);
  color: var(--sage-deep);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 30rpx;
  text-align: center;
}

.submit-button {
  width: 100%;
  height: 92rpx;
  margin-top: 28rpx;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: var(--sage-deep);
  box-shadow: 0 12rpx 28rpx rgba(108, 126, 88, 0.24);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 92rpx;
}

.submit-button::after {
  border: 0;
}

.submit-button-hover {
  opacity: 0.86;
  transform: translateY(1rpx);
}

.submit-button[disabled] {
  background: var(--sage-soft);
  color: rgba(255, 255, 255, 0.88);
}

.upload-progress {
  margin-top: 16rpx;
  color: var(--sage-deep);
  font-size: 20rpx;
  text-align: center;
}
