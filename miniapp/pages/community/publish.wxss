.publish-page { min-height: 100vh; background: var(--cream); padding-bottom: 60rpx; }.publish-head { padding: 72rpx 36rpx 42rpx; background: linear-gradient(180deg,#e3edd6,var(--cream)); }.publish-kicker { color: var(--sage-deep); letter-spacing: .16em; font-size: 19rpx; }.publish-title { margin-top: 16rpx; font-family: serif; font-size: 44rpx; font-weight: 900; }.publish-hint { margin-top: 14rpx; color: var(--muted); line-height: 1.6; font-size: 22rpx; }.publish-form { padding: 28rpx 34rpx; }.field { margin-bottom: 30rpx; }.field > text { display: block; color: var(--sage-deep); font-size: 22rpx; font-weight: 800; margin-bottom: 12rpx; }.field input,.field textarea { width: 100%; padding: 18rpx 20rpx; background: var(--paper); border: 1rpx solid var(--line); border-radius: 14rpx; font-size: 24rpx; box-sizing: border-box; }.field textarea { min-height: 190rpx; line-height: 1.6; }.topic-scroll { white-space: nowrap; }.topic-chip { display: inline-block; padding: 10rpx 18rpx; margin-right: 10rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--muted); background: var(--paper); font-size: 21rpx; }.topic-chip.active { color: var(--sage-deep); border-color: var(--sage); background: var(--sage-mist); }.image-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12rpx; }.upload-image,.add-image { position: relative; aspect-ratio: 1; border-radius: 12rpx; overflow: hidden; background: var(--paper); border: 1rpx solid var(--line); }.upload-image image { width: 100%; height: 100%; }.remove-image { position: absolute; right: 8rpx; top: 8rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: rgba(60,52,44,.7); color: #fff; text-align: center; line-height: 34rpx; font-size: 28rpx; }.add-image { display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--sage-deep); font-size: 45rpx; }.add-image text { font-size: 18rpx; }.publish-note { color: var(--muted); font-size: 20rpx; line-height: 1.5; }.submit-button { width: 100%; margin-top: 24rpx; height: 84rpx; line-height: 84rpx; border: 0; border-radius: 999rpx; color: #fff; background: var(--sage); font-size: 26rpx; }.upload-progress { text-align: center; margin-top: 16rpx; color: var(--sage-deep); font-size: 20rpx; }
