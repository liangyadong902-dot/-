<view class="post-detail-page">
  <view wx:if="{{loading}}" class="detail-state">正在打开这篇旅途笔记…</view>
  <view wx:elif="{{error}}" class="detail-state"><text>{{error}}</text><view class="state-button" bindtap="load">重新加载</view></view>
  <block wx:elif="{{post}}">
    <view class="cd-head" style="padding-top: {{statusBarHeight}}px;">
      <view class="cd-nav-row" style="height: {{navBarHeight}}px;">
        <view class="cd-close" bindtap="goBack">←</view>
      </view>
      <view class="cd-head-row">
        <view class="cd-avatar">
          <image wx:if="{{post.author.avatarUrl}}" class="cd-avatar-img" src="{{post.author.avatarUrl}}" mode="aspectFill" />
          <block wx:else>{{authorMark}}</block>
        </view>
        <view class="cd-author">
          <view class="cd-name">{{post.author.nickname || '途友'}}</view>
          <view class="cd-place">{{post.locationName || '旅途中'}}</view>
        </view>
        <view class="cd-follow {{post.author.followed ? 'active' : ''}}" bindtap="followAuthor">{{post.author.followed ? '已关注' : '关注'}}</view>
      </view>
    </view>
    <scroll-view class="cd-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:if="{{post.imageUrls.length}}" class="cd-media-wrap">
        <swiper class="cd-media" circular="{{post.imageUrls.length > 1}}" bindchange="onMediaChange">
          <swiper-item wx:for="{{post.imageUrls}}" wx:key="*this"><image class="cd-media-img" src="{{item}}" mode="aspectFill" /></swiper-item>
        </swiper>
        <view wx:if="{{post.imageUrls.length > 1}}" class="cd-media-dots">
          <view wx:for="{{post.imageUrls}}" wx:key="index" class="cd-media-dot {{mediaIndex === index ? 'on' : ''}}"></view>
        </view>
      </view>
      <view class="cd-body">
        <view class="cd-title">{{post.title}}</view>
        <view class="cd-text">{{post.content}}</view>
        <view class="cd-tags">
          <text>#{{post.topic ? post.topic.name : '旅途'}}</text>
          <text>#盲盒开箱</text>
          <text>#周末出发</text>
        </view>
        <view class="cd-meta">{{post.locationName || '旅途中'}} · 最近更新</view>
        <view wx:if="{{post.linkedBox}}" class="cd-samebox" data-id="{{post.linkedBox.id}}" bindtap="openBox">
          <image class="samebox-img" src="{{post.linkedBox.coverUrl}}" mode="aspectFill" />
          <view class="samebox-copy">
            <view class="samebox-name">{{post.linkedBox.name}}</view>
            <view class="samebox-sub">{{post.linkedBox.subtitle}}</view>
          </view>
          <view class="samebox-go">查看同款 ›</view>
        </view>
        <view wx:if="{{post.linkedTrip}}" class="cd-samebox" data-id="{{post.linkedTrip.id}}" bindtap="openTrip">
          <image class="samebox-img" src="{{post.linkedTrip.coverUrl}}" mode="aspectFill" />
          <view class="samebox-copy">
            <view class="samebox-name">{{post.linkedTrip.name}}</view>
            <view class="samebox-sub">{{post.linkedTrip.subtitle}}</view>
          </view>
          <view class="samebox-go">查看行程 ›</view>
        </view>
        <view wx:if="{{post.linkedCheckin}}" class="cd-samebox" data-id="{{post.linkedCheckin.id}}" bindtap="openCheckin">
          <image class="samebox-img" src="{{post.linkedCheckin.coverUrl}}" mode="aspectFill" />
          <view class="samebox-copy">
            <view class="samebox-name">{{post.linkedCheckin.name}}</view>
            <view class="samebox-sub">{{post.linkedCheckin.subtitle}}</view>
          </view>
          <view class="samebox-go">查看打卡 ›</view>
        </view>
        <view class="cd-divider"></view>
        <view class="cd-comment-title">共 {{post.commentCount}} 条评论</view>
        <view wx:if="{{!comments.length}}" class="cd-comment-empty">还没有评论，留下第一句吧</view>
        <view wx:for="{{comments}}" wx:key="commentId" class="cd-comment">
          <view class="cd-avatar sm">
            <image wx:if="{{item.author.avatarUrl}}" class="cd-avatar-img" src="{{item.author.avatarUrl}}" mode="aspectFill" />
            <block wx:else>{{item.mark}}</block>
          </view>
          <view class="cd-comment-copy">
            <view class="cd-comment-name">
              <text>{{item.author.nickname}}</text>
              <text wx:if="{{item.isAuthor}}" class="cd-author-badge">作者</text>
            </view>
            <view class="cd-comment-text">{{item.content}}</view>
            <view class="cd-comment-meta"><block wx:if="{{item.createdAtText}}">{{item.createdAtText}} · </block><text class="cd-reply" data-index="{{index}}" data-name="{{item.author.nickname}}" catchtap="reply">回复</text></view>
            <view wx:if="{{item.replies.length}}" class="cd-sub">
              <block wx:for="{{item.replies}}" wx:for-item="sub" wx:for-index="subIndex" wx:key="commentId">
                <view wx:if="{{item.expanded || subIndex <= 1}}" class="cd-sub-item">
                  <view class="cd-sub-avatar">
                    <image wx:if="{{sub.author.avatarUrl}}" class="cd-sub-avatar-img" src="{{sub.author.avatarUrl}}" mode="aspectFill" />
                    <block wx:else>{{sub.mark}}</block>
                  </view>
                  <view class="cd-sub-main">
                    <view class="cd-sub-text"><text class="cd-sub-name">{{sub.author.nickname}}</text><text wx:if="{{sub.isAuthor}}" class="cd-author-badge">作者</text><text wx:if="{{sub.replyToName}}" class="cd-sub-replyto"> 回复 @{{sub.replyToName}}</text><text class="cd-sub-content">：{{sub.content}}</text></view>
                    <view class="cd-sub-meta"><block wx:if="{{sub.createdAtText}}">{{sub.createdAtText}} · </block><text class="cd-reply" data-index="{{index}}" data-sub="{{subIndex}}" data-name="{{sub.author.nickname}}" catchtap="reply">回复</text></view>
                  </view>
                </view>
              </block>
              <view wx:if="{{item.replies.length >= 3}}" class="cd-sub-toggle" data-index="{{index}}" catchtap="toggleReplies">
                <text>{{item.expanded ? '收起' : '共 ' + item.replies.length + ' 条回复'}}</text>
                <text class="cd-sub-arrow {{item.expanded ? 'up' : ''}}">›</text>
              </view>
            </view>
          </view>
        </view>
        <view class="cd-body-pad"></view>
      </view>
    </scroll-view>
    <view class="cd-bar">
      <view wx:if="{{replyName}}" class="cd-reply-tag">
        <text class="cd-reply-tag-text">回复 @{{replyName}}</text>
        <text class="cd-reply-tag-close" catchtap="cancelReply">×</text>
      </view>
      <view class="cd-bar-row">
        <view class="cd-input-wrap">
          <input class="cd-input" value="{{input}}" placeholder="{{replyName ? '回复 @' + replyName : '说点旅途见闻…'}}" placeholder-class="cd-ph" maxlength="120" bindinput="inputChange" bindconfirm="sendComment" confirm-type="send" />
        </view>
        <view class="cd-action {{post.liked ? 'active' : ''}}" bindtap="toggleLike"><text class="cd-action-icon">{{post.liked ? '♥' : '♡'}}</text></view>
        <view class="cd-action collect {{post.collected ? 'active' : ''}}" bindtap="toggleCollect"><text class="cd-action-icon">{{post.collected ? '★' : '☆'}}</text></view>
        <button class="cd-action share" open-type="share" hover-class="none"><text class="cd-action-icon">↑</text></button>
      </view>
    </view>
  </block>
</view>
