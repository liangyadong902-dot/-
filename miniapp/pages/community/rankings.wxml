<view class="rank-page"><view class="rank-head"><text class="kicker">COMMUNITY CREATORS</text><text class="title">旅行达人榜</text><text class="desc">按真实发帖、打卡和互动数据排序</text></view><view class="tabs"><view wx:for="{{tabs}}" wx:key="key" class="tab {{metric === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="switchMetric">{{item.label}}</view></view><view wx:if="{{loading}}" class="state">正在整理榜单…</view><view wx:elif="{{error}}" class="state">{{error}}</view><view wx:else class="list"><view wx:for="{{creators}}" wx:key="userId" class="creator"><text class="rank">{{item.rank}}</text><image src="{{item.avatarUrl}}" mode="aspectFill"/><view class="copy"><text class="name">{{item.nickname}}</text><text class="meta">{{item.postCount}} 篇笔记 · {{item.checkinCount}} 次打卡</text></view><button data-id="{{item.userId}}" data-followed="{{item.followed}}" bindtap="follow">{{item.followed ? '已关注' : '关注'}}</button></view><view wx:if="{{!creators.length}}" class="state">暂时还没有达人数据</view></view></view>
