<view class="checkin-detail"><view wx:if="{{loading}}" class="state">正在打开打卡记录…</view><view wx:elif="{{error}}" class="state">{{error}}<button bindtap="load">重试</button></view><block wx:elif="{{item}}"><view class="detail-user"><image src="{{item.user.avatarUrl || '/assets/mascot/heart.png'}}" mode="aspectFill"/><view><view>{{item.user.nickname}}</view><text>{{item.createdAt}}</text></view></view><swiper class="photo-swiper" indicator-dots="{{item.imageUrls.length > 1}}" circular="{{item.imageUrls.length > 1}}"><swiper-item wx:for="{{item.imageUrls}}" wx:key="*this"><image src="{{item}}" mode="aspectFill"/></swiper-item></swiper><view class="copy"><view class="place">{{item.locationName}}</view><view class="note">{{item.note || '这次旅程值得被记住。'}}</view><view class="actions"><button bindtap="toggleLike">{{item.liked ? '♥' : '♡'}} {{item.likeCount}}</button><button bindtap="makePoster">生成海报</button><button bindtap="openTrip">查看行程</button></view></view></block></view>
