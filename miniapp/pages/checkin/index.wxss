.checkin-page { min-height: 100vh; background: var(--cream); }.checkin-head { padding: 72rpx 34rpx 42rpx; background: linear-gradient(180deg,#e3edd6,var(--cream)); }.kicker { color: var(--sage-deep); letter-spacing: .16em; font-size: 18rpx; }.title { margin-top: 14rpx; font-family: serif; font-size: 44rpx; font-weight: 900; }.head-row { display:flex; justify-content:space-between; align-items:center; margin-top: 14rpx; color: var(--muted); font-size: 21rpx; }.head-row button { margin:0; color:var(--sage-deep); background:var(--paper); border:1rpx solid var(--line); border-radius:999rpx; font-size:20rpx; }.state { min-height: 50vh; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16rpx; color:var(--muted); font-size:23rpx; }.state button { color:#fff; background:var(--sage); border:0; border-radius:999rpx; font-size:20rpx; }.mark { width:90rpx; height:90rpx; display:grid; place-items:center; background:var(--sage-mist); border-radius:50%; color:var(--sage-deep); font-size:42rpx; }.muted { font-size:20rpx; }.checkin-grid { padding: 26rpx 30rpx; display:grid; grid-template-columns:1fr 1fr; gap:18rpx; }.checkin-card { background:var(--paper); border:1rpx solid var(--line); border-radius:16rpx; overflow:hidden; }.checkin-card image { width:100%; height:240rpx; background:var(--cream-2); }.checkin-body { padding:16rpx; }.place { font-size:25rpx; font-weight:800; }.note { margin-top:8rpx; color:var(--muted); font-size:20rpx; line-height:1.45; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }.meta { margin-top:12rpx; color:var(--sage-deep); font-size:18rpx; }
