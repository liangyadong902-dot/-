<view class="ranking-page"><view class="ranking-head"><view class="kicker">CHECK-IN RANKING</view><view class="title">旅途打卡榜</view><view class="periods"><view wx:for="{{['week','month','all']}}" wx:key="*this" class="period {{period===item?'active':''}}" data-period="{{item}}" bindtap="switchPeriod">{{item==='week'?'本周':item==='month'?'本月':'总榜'}}</view></view></view><view wx:if="{{loading}}" class="state">正在计算排行…</view><view wx:else class="ranking-list"><view wx:for="{{list}}" wx:key="checkinId" class="ranking-item"><view class="rank">{{index+1}}</view><image src="{{item.user.avatarUrl || '/assets/mascot/heart.png'}}" mode="aspectFill"/><view class="user"><view>{{item.user.nickname}}</view><text>{{item.locationName}}</text></view><view class="likes">♡ {{item.likeCount}}</view></view></view></view>
