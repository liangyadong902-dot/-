.checkin-detail { min-height:100vh; background:var(--cream); }.state { min-height:70vh; display:flex; flex-direction:column; justify-content:center; align-items:center; gap:18rpx; color:var(--muted); font-size:23rpx; }.state button { color:#fff; background:var(--sage); border:0; border-radius:999rpx; font-size:20rpx; }.detail-user { display:flex; align-items:center; gap:16rpx; padding:28rpx 34rpx; background:var(--paper); font-size:25rpx; font-weight:800; }.detail-user image { width:68rpx; height:68rpx; border-radius:50%; background:var(--sage-mist); }.detail-user text { display:block; margin-top:5rpx; color:var(--muted); font-size:18rpx; font-weight:400; }.photo-swiper { width:100%; height:560rpx; background:var(--cream-2); }.photo-swiper image { width:100%; height:100%; }.copy { padding:28rpx 34rpx; background:var(--paper); }.place { font-family:serif; font-size:40rpx; font-weight:900; }.note { margin-top:16rpx; color:var(--muted); font-size:25rpx; line-height:1.7; }.actions { display:flex; gap:12rpx; margin-top:28rpx; }.actions button { flex:1; margin:0; border:0; border-radius:999rpx; background:var(--cream); color:var(--ink); font-size:20rpx; }.actions button:last-child { color:#fff; background:var(--sage); }
