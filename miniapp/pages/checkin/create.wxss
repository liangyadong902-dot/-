.checkin-create { min-height:100vh; background:var(--cream); }.create-head { padding:72rpx 34rpx 42rpx; background:linear-gradient(180deg,#e3edd6,var(--cream)); }.kicker { color:var(--sage-deep); letter-spacing:.16em; font-size:18rpx; }.title { margin-top:14rpx; font-family:serif; font-size:44rpx; font-weight:900; }.desc { margin-top:12rpx; color:var(--muted); font-size:21rpx; line-height:1.6; }.form { padding:26rpx 34rpx 60rpx; }.field { margin-bottom:26rpx; }.field>text { display:block; color:var(--sage-deep); font-weight:800; font-size:22rpx; margin-bottom:12rpx; }.field input,.field textarea { width:100%; box-sizing:border-box; border:1rpx solid var(--line); border-radius:14rpx; background:var(--paper); font-size:24rpx; }
/* 原生 input 加纵向 padding 会导致文字被裁切：固定高度+行高居中，只保留横向 padding */
.field input { height:84rpx; line-height:84rpx; padding:0 20rpx; }
.loc-row { display:flex; align-items:center; gap:12rpx; }.loc-row input { flex:1; min-width:0; }.loc-btn { flex-shrink:0; height:84rpx; line-height:84rpx; padding:0 24rpx; border-radius:999rpx; background:var(--sage); color:#fff; font-size:22rpx; font-weight:700; }.loc-addr { margin-top:10rpx; color:var(--sage-deep); font-size:20rpx; line-height:1.5; }
.field textarea { padding:18rpx 20rpx; min-height:160rpx; line-height:1.6; }.image-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12rpx; }.image-item,.add { position:relative; aspect-ratio:1; overflow:hidden; border-radius:12rpx; border:1rpx solid var(--line); background:var(--paper); }.image-item image { width:100%; height:100%; }.remove { position:absolute; right:8rpx; top:8rpx; width:36rpx; height:36rpx; border-radius:50%; line-height:34rpx; text-align:center; color:#fff; background:rgba(60,52,44,.7); font-size:28rpx; }.add { display:flex; flex-direction:column; justify-content:center; align-items:center; color:var(--sage-deep); font-size:44rpx; }.add text { font-size:18rpx; }.submit { height:84rpx; line-height:84rpx; color:#fff; background:var(--sage); border:0; border-radius:999rpx; font-size:26rpx; }.progress { text-align:center; margin-top:14rpx; color:var(--sage-deep); font-size:20rpx; }
