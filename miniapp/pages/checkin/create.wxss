.checkin-create { min-height:100vh; background:var(--cream); }.create-head { padding:72rpx 34rpx 42rpx; background:linear-gradient(180deg,#e3edd6,var(--cream)); }.kicker { color:var(--sage-deep); letter-spacing:.16em; font-size:18rpx; }.title { margin-top:14rpx; font-family:serif; font-size:44rpx; font-weight:900; }.desc { margin-top:12rpx; color:var(--muted); font-size:21rpx; line-height:1.6; }.form { padding:26rpx 34rpx 60rpx; }.field { margin-bottom:26rpx; }.field>text { display:block; color:var(--sage-deep); font-weight:800; font-size:22rpx; margin-bottom:12rpx; }.field input,.field textarea { width:100%; box-sizing:border-box; padding:18rpx 20rpx; border:1rpx solid var(--line); border-radius:14rpx; background:var(--paper); font-size:24rpx; }.field textarea { min-height:160rpx; line-height:1.6; }.image-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12rpx; }.image-item,.add { position:relative; aspect-ratio:1; overflow:hidden; border-radius:12rpx; border:1rpx solid var(--line); background:var(--paper); }.image-item image { width:100%; height:100%; }.remove { position:absolute; right:8rpx; top:8rpx; width:36rpx; height:36rpx; border-radius:50%; line-height:34rpx; text-align:center; color:#fff; background:rgba(60,52,44,.7); font-size:28rpx; }.add { display:flex; flex-direction:column; justify-content:center; align-items:center; color:var(--sage-deep); font-size:44rpx; }.add text { font-size:18rpx; }.submit { height:84rpx; line-height:84rpx; color:#fff; background:var(--sage); border:0; border-radius:999rpx; font-size:26rpx; }.progress { text-align:center; margin-top:14rpx; color:var(--sage-deep); font-size:20rpx; }
