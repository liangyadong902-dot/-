.ranking-page { min-height:100vh; background:var(--cream); }.ranking-head { padding:72rpx 34rpx 34rpx; background:linear-gradient(180deg,#e3edd6,var(--cream)); }.kicker { color:var(--sage-deep); letter-spacing:.16em; font-size:18rpx; }.title { margin-top:14rpx; font-family:serif; font-size:44rpx; font-weight:900; }.periods { display:flex; gap:12rpx; margin-top:26rpx; }.period { padding:10rpx 22rpx; border-radius:999rpx; border:1rpx solid var(--line); background:var(--paper); color:var(--muted); font-size:21rpx; }.period.active { color:var(--sage-deep); background:var(--sage-mist); border-color:var(--sage); }.state { min-height:50vh; display:grid; place-items:center; color:var(--muted); }.ranking-list { padding:20rpx 34rpx; }.ranking-item { display:flex; align-items:center; gap:16rpx; padding:22rpx 0; border-bottom:1rpx solid var(--line); }.rank { width:34rpx; color:var(--caramel); font-size:28rpx; font-weight:900; text-align:center; }.ranking-item image { width:66rpx; height:66rpx; border-radius:50%; background:var(--sage-mist); }.user { flex:1; font-size:24rpx; font-weight:800; }.user text { display:block; margin-top:6rpx; color:var(--muted); font-size:19rpx; font-weight:400; }.likes { color:var(--sage-deep); font-size:21rpx; }
