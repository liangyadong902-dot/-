<view class="page-home tab-view active">
  <view class="cloud-head">
    <view class="scallop-row">
      <view class="scallop"></view>
      <view class="scallop"></view>
      <view class="scallop"></view>
      <view class="scallop"></view>
      <view class="scallop"></view>
      <view class="scallop"></view>
      <view class="scallop"></view>
    </view>
    <view class="brand-row">
      <view class="menu-btn">
        <view class="bar"></view>
        <view class="bar"></view>
        <view class="bar"></view>
      </view>
      <view class="brand-copy">
        <view class="cursive-wrap">
          <view class="cursive">Good Journey!</view>
          <image class="leaf-mark" src="/assets/mascot/leaf.png" mode="aspectFit" />
        </view>
        <view class="shop-title">
          <view>途个</view>
          <view>惊喜</view>
        </view>
        <view class="slogan">
          <text>随盒出发，途个好心情</text>
          <image class="slogan-heart" src="/assets/mascot/heart.png" mode="aspectFit" />
        </view>
      </view>
      <view class="mascot-col">
        <view class="speech">今天也要好好出发呀！</view>
        <image class="mascot-svg" src="/assets/mascot/home-dog.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="special-block">
    <view class="special-photo" bindtap="openCurrentSpecial">
      <!-- 原型始终展示今日特选；接口尚未返回时使用本地封面保持首屏完整 -->
      <image class="special-img" src="{{special.img || '/assets/covers/box2.jpg'}}" mode="aspectFill" />
      <view class="v-label">FRESH JOURNEY</view>
      <view class="photo-tag"><text>途个</text><text>惊喜</text></view>
      <view class="fresh-orb"><text>今日</text><text>新鲜出发</text></view>
    </view>
    <view class="special-copy">
      <view class="eyebrow">TODAY'S SPECIAL</view>
      <view class="h2">{{specialName || '隐世古村\n慢生活盒'}}</view>
      <view class="p">{{specialDesc || '非遗体验 · 古镇慢游\n随机解锁主题线路'}}</view>
      <view class="link-cta" bindtap="openCurrentSpecial">
        <text>查看详情</text>
        <image class="cta-arrow" src="/assets/icons/arrow.png" mode="aspectFit" />
      </view>
      <image class="doodle-arrow" src="/assets/icons/doodle-arrow.png" mode="aspectFit" />
      <view class="pager">
        <block wx:for="{{specialPager}}" wx:key="n">
          <view class="pg {{item.on ? 'on' : ''}}" data-n="{{item.n}}" bindtap="setSpecial">{{item.lab}}</view>
          <text wx:if="{{item.n < 2}}">—</text>
        </block>
      </view>
    </view>
  </view>

  <view class="search-row">
    <view class="search-box">
      <image class="search-ico" src="/assets/icons/search.png" mode="aspectFit" />
      <input
        value="{{searchKeyword}}"
        placeholder="今天想去哪里放空呢？"
        placeholder-class="ph"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="submitSearch"
      />
      <view class="btn-search" bindtap="submitSearch">搜索</view>
    </view>
    <view class="gift-btn" bindtap="goBadges">
      <image class="gift-ico" src="/assets/icons/gift.png" mode="aspectFit" />
      <text class="small">图鉴</text>
    </view>
  </view>

  <scroll-view class="mood-row" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="mood-inner">
      <view
        wx:for="{{moods}}"
        wx:key="key"
        class="mood-chip {{mood === item.key ? 'active' : ''}}"
        data-mood="{{item.key}}"
        bindtap="filterMood"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="category-row">
    <view class="category-item {{category === 'nearby' ? 'active' : ''}}" data-cat="nearby" bindtap="filterCategory">
      <view class="cat-icon">
        <image src="/assets/icons/cat-nearby.png" mode="aspectFit" />
      </view>
      <view class="cat-name">周边游</view>
      <view class="cat-en">NEARBY</view>
    </view>
    <view class="category-item {{category === 'province' ? 'active' : ''}}" data-cat="province" bindtap="filterCategory">
      <view class="cat-icon">
        <image src="/assets/icons/cat-province.png" mode="aspectFit" />
      </view>
      <view class="cat-name">省内游</view>
      <view class="cat-en">PROVINCE</view>
    </view>
    <view class="category-item {{category === 'cross' ? 'active' : ''}}" data-cat="cross" bindtap="filterCategory">
      <view class="cat-icon">
        <image src="/assets/icons/cat-cross.png" mode="aspectFit" />
      </view>
      <view class="cat-name">跨省游</view>
      <view class="cat-en">CROSS</view>
    </view>
    <view class="category-item {{category === 'theme' ? 'active' : ''}}" data-cat="theme" bindtap="filterCategory">
      <view class="cat-icon">
        <image src="/assets/icons/cat-theme.png" mode="aspectFit" />
      </view>
      <view class="cat-name">主题盒</view>
      <view class="cat-en">THEME</view>
    </view>
  </view>

  <!-- 心情开箱：选心情 → 推送可能喜欢的盲盒 → 一键开箱 -->
  <view class="mood-unbox">
    <view class="mood-unbox-head">
      <view class="mood-unbox-title">
        <image class="sec-leaf" src="/assets/icons/leaf.png" mode="aspectFit" />
        <text>此刻的心情是？</text>
      </view>
      <text class="mood-unbox-en">MOOD UNBOX</text>
    </view>
    <view class="mood-unbox-chips">
      <view
        wx:for="{{moodPickOptions}}"
        wx:key="key"
        class="mood-unbox-chip {{moodPick === item.key ? 'on' : ''}}"
        data-mood="{{item.key}}"
        bindtap="pickMood"
      >
        <text class="mood-unbox-emoji">{{item.emoji}}</text>
        <text>{{item.label}}</text>
      </view>
    </view>
    <view wx:if="{{!moodPick}}" class="mood-unbox-hint">
      <text>选个心情，小途为你推送一盒可能喜欢的盲盒</text>
    </view>
    <view wx:elif="{{moodPickLoading}}" class="mood-unbox-hint">
      <text>正在为你挑选盲盒…</text>
    </view>
    <view wx:elif="{{moodPickEmpty}}" class="mood-unbox-hint">
      <text>这个心情暂时没有匹配的盲盒，换个心情试试</text>
    </view>
    <view wx:else class="mood-unbox-card">
      <!-- 只展示数据库真实封面；无图时显示中性占位，不用假图兜底 -->
      <image wx:if="{{moodPickBox.img}}" class="mood-unbox-img" src="{{moodPickBox.img}}" mode="aspectFill" />
      <view wx:else class="mood-unbox-img mood-unbox-img-blank"><text>封面暂缺</text></view>
      <view class="mood-unbox-info">
        <view class="mood-unbox-line">{{moodPickLine}}</view>
        <view class="mood-unbox-name">{{moodPickBox.name}}</view>
        <view class="mood-unbox-desc">{{moodPickBox.desc}}</view>
        <view class="mood-unbox-meta">
          <text class="mood-unbox-price">¥{{moodPickBox.price}}</text>
        </view>
        <view class="mood-unbox-actions">
          <view class="mood-unbox-open" bindtap="openMoodPick">开箱</view>
          <view class="mood-unbox-rotate" bindtap="rotateMoodPick">换一个 ›</view>
        </view>
      </view>
    </view>
  </view>

  <swiper
    wx:if="{{banners.length}}"
    class="member-banner-swiper"
    indicator-dots="{{banners.length > 1}}"
    autoplay="{{banners.length > 1}}"
    circular="{{banners.length > 1}}"
    interval="4500"
    indicator-color="rgba(60,52,44,0.18)"
    indicator-active-color="#6C7E58"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="member-banner-inner" data-id="{{item.id}}" bindtap="onBanner">
        <view class="copy">
          <view class="kicker">{{item.tag || 'MEMBER BENEFITS'}}</view>
          <view class="h3">{{item.title}}</view>
          <view class="ink-pill">立即开启</view>
        </view>
        <image class="photo" src="{{item.imageUrl}}" mode="aspectFill" />
      </view>
    </swiper-item>
  </swiper>
  <!-- 活动接口为空时仍保留原型中的会员权益卡，避免首屏出现空白断层 -->
  <view wx:else class="member-banner empty" bindtap="openCurrentSpecial">
    <view class="copy">
      <view class="kicker">MEMBER BENEFITS</view>
      <view class="h3">开盒解锁主题行程</view>
      <view class="ink-pill">立即开启</view>
    </view>
    <image class="photo" src="/assets/covers/box1.jpg" mode="aspectFill" />
  </view>

  <view class="section-pad">
    <view class="section-header">
      <view class="section-title">
        <image class="sec-leaf" src="/assets/icons/leaf.png" mode="aspectFit" />
        <text>{{searchActive ? '搜索结果' : '人气推荐'}}</text>
        <image class="sec-heart" src="/assets/icons/heart.png" mode="aspectFit" />
      </view>
      <text wx:if="{{searchActive}}" class="view-more" bindtap="clearSearch">清除搜索 ›</text>
      <text wx:else class="view-more" bindtap="filterCategoryAll">查看更多 ›</text>
    </view>
    <view wx:if="{{searching}}" class="empty-hint">正在搜索…</view>
    <view wx:elif="{{!contentLoaded}}" class="empty-hint">正在读取盲盒...</view>
    <view wx:elif="{{productsEmpty}}" class="empty-hint">{{contentError || (searchActive ? '没找到相关盲盒，换个关键词试试' : '暂无匹配盲盒，换个心情看看')}}</view>
    <view wx:else class="product-grid">
      <view class="product-card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="openProduct">
        <view class="prod-img-wrap">
          <image src="{{item.img}}" mode="aspectFill" />
          <view class="top-badge">{{item.rank}}</view>
        </view>
        <view class="prod-info">
          <view class="prod-name">{{item.name}}</view>
          <view class="prod-desc">{{item.desc}}</view>
          <view class="prod-bottom">
            <view class="prod-price"><text class="yen">¥</text>{{item.price}}</view>
            <view class="btn-add" data-id="{{item.id}}" catchtap="openUnbox">+</view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="tab-safe"></view>
  <tuge-overlay />
</view>
