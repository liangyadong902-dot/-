<view class="page">
  <view class="tabs">
    <view class="tab {{status==='unused'?'on':''}}" data-status="unused" bindtap="switchStatus">未使用</view>
    <view class="tab {{status==='used'?'on':''}}" data-status="used" bindtap="switchStatus">已使用</view>
    <view class="tab {{status==='expired'?'on':''}}" data-status="expired" bindtap="switchStatus">已过期</view>
  </view>
  <view wx:if="{{loading}}" class="hint">加载中...</view>
  <view wx:elif="{{error}}" class="hint" bindtap="retry">{{error}}</view>
  <view wx:elif="{{empty}}" class="hint">暂无优惠券</view>
  <view wx:else class="list">
    <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="name">{{item.name}}</view>
      <view class="meta">有效期至 {{item.validUntil}}</view>
      <view class="src">来源 {{item.source}}</view>
    </view>
  </view>
</view>
