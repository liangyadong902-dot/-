.page{min-height:100vh;padding:100rpx 34rpx 50rpx;background:var(--cream);color:var(--ink)}.tabs{display:flex;gap:14rpx;margin-bottom:26rpx}.tab{padding:12rpx 24rpx;border-radius:999rpx;background:var(--paper);color:var(--muted);font-size:21rpx;box-shadow:0 4rpx 14rpx rgba(60,52,44,.04)}.tab.on{background:var(--sage-deep);color:#fff}.hint{color:var(--muted);padding:120rpx 0;text-align:center;font-size:23rpx}.list{display:flex;flex-direction:column;gap:20rpx}.card{background:var(--paper);border-radius:26rpx;padding:26rpx;box-shadow:0 8rpx 28rpx rgba(60,52,44,.06)}.name{font-family:"Noto Serif SC",serif;font-weight:800;font-size:30rpx}.meta,.src{color:var(--muted);font-size:21rpx;margin-top:10rpx}
