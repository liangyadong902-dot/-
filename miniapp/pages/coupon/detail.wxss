.page{min-height:100vh;padding:100rpx 34rpx 50rpx;background:var(--cream);color:var(--ink)}.hint{color:var(--muted);padding:120rpx 0;text-align:center;font-size:23rpx}.card{background:var(--paper);border-radius:26rpx;padding:30rpx;box-shadow:0 8rpx 28rpx rgba(60,52,44,.06)}.name{font-family:"Noto Serif SC",serif;font-weight:900;font-size:36rpx;margin-bottom:18rpx}.row{color:var(--muted);font-size:23rpx;margin-bottom:12rpx;line-height:1.5}.btn{margin-top:26rpx;background:var(--sage);color:#fff;border:0;border-radius:999rpx}.ok{color:var(--sage-deep);margin-top:18rpx;font-weight:700}
