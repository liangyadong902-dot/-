.page-shell{min-height:100vh;background:var(--cream);padding-bottom:70rpx}.head{padding:88rpx 34rpx 40rpx;background:linear-gradient(180deg,#e3edd6,var(--cream))}.kicker{display:block;color:var(--sage-deep);font-size:18rpx;letter-spacing:.16em}.title{display:block;margin-top:12rpx;font:900 46rpx/1.2 serif}.desc{display:block;margin-top:10rpx;color:var(--muted);font-size:21rpx}.list{padding:24rpx 28rpx}.record{padding:24rpx;background:var(--paper);border:1rpx solid var(--line);border-radius:18rpx;margin-bottom:16rpx}.row{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.name{font-weight:800;font-size:25rpx}.result{color:var(--muted);font-size:20rpx}.result.ok{color:var(--sage-deep)}.meta,.foot{margin-top:12rpx;color:var(--muted);font-size:19rpx}.foot{margin-top:20rpx}.price{color:var(--ink);font-weight:800;font-size:26rpx}.state{min-height:48vh;display:grid;place-items:center;color:var(--muted)}
