<view class="page-shell"><view class="head"><text class="kicker">PAYMENT RECORDS</text><text class="title">支付记录</text><text class="desc">支付结果以服务端流水为准</text></view><view wx:if="{{loading}}" class="state">正在读取…</view><view wx:elif="{{error}}" class="state">{{error}}</view><view wx:elif="{{empty}}" class="state">还没有支付记录</view><view wx:else class="list"><view wx:for="{{records}}" wx:key="paymentNo" class="record"><view class="row"><text class="name">{{item.boxName || item.orderNo}}</text><text class="result {{item.result === 'success' ? 'ok' : ''}}">{{item.result}}</text></view><view class="meta">{{item.paymentNo}} · {{item.channel}}</view><view class="row foot"><text>{{item.paidAt || item.createdAt}}</text><text class="price">¥{{item.amountText}}</text></view></view></view></view>
