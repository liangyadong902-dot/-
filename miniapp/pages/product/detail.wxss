/* 商品详情：对照 index-app-latest.html .product-detail-*，390px → 750rpx */
.product-page { min-height: 100vh; background: var(--cream); }
.state { min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; color: var(--muted); }
.state button { color: #fff; background: var(--sage); border: 0; border-radius: 8rpx; }

.pd-hero { position: relative; height: 634.62rpx; overflow: hidden; background: var(--cream-2); }
.pd-hero-swiper { width: 100%; height: 100%; }
.pd-hero-img { width: 100%; height: 100%; display: block; }
.pd-hero-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(circle at 50% 35%, #edf4e5, #b7c8a5); color: var(--sage-deep); font-family: "Noto Serif SC", serif; font-size: 48rpx; font-weight: 900; }
.pd-hero-placeholder-sub { margin-top: 13rpx; font-family: "Noto Sans SC", sans-serif; font-size: 17rpx; letter-spacing: .16em; font-weight: 700; }
.pd-hero-fade {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 211.54rpx;
  background: linear-gradient(180deg, transparent, rgba(28, 24, 20, 0.42));
  pointer-events: none;
}
.pd-back {
  position: absolute;
  top: 103.85rpx;
  left: 30.77rpx;
  z-index: 3;
  width: 84.62rpx;
  height: 84.62rpx;
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.92);
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38.46rpx;
  box-shadow: 0 7.69rpx 26.92rpx rgba(60, 52, 44, 0.16);
}
.pd-rank {
  position: absolute;
  left: 34.62rpx;
  bottom: 34.62rpx;
  z-index: 2;
  padding: 9.62rpx 19.23rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.92);
  color: var(--sage-deep);
  font-size: 19.23rpx;
  font-weight: 800;
}

.pd-body { padding: 38.46rpx 34.62rpx 26.92rpx; }
.pd-unbox-head {
  margin: -4rpx 0 34rpx;
  padding: 27rpx 27rpx 25rpx;
  border: 2rpx solid var(--sage-soft);
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--sage-mist), #f7f4e9);
  box-shadow: 0 10rpx 26rpx rgba(108,126,88,.08);
}
.pd-unbox-kicker { color: var(--sage-deep); font-size: 17rpx; font-weight: 800; letter-spacing: .16em; }
.pd-unbox-title { margin-top: 11rpx; font-family: "Noto Serif SC", "Songti SC", serif; font-size: 31rpx; font-weight: 900; line-height: 1.35; }
.pd-unbox-copy { margin-top: 8rpx; color: var(--muted); font-size: 20rpx; line-height: 1.6; }
.pd-unbox-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.pd-tag { display: inline-flex; align-items: center; min-height: 38rpx; padding: 0 13rpx; border-radius: 999rpx; background: rgba(255,253,248,.84); color: var(--muted); font-size: 17rpx; font-weight: 700; }
.pd-tag-accent { color: var(--sage-deep); background: var(--paper); }
.pd-title { font-family: "Noto Serif SC", "Songti SC", serif; font-size: 46.15rpx; font-weight: 900; line-height: 1.35; }
.pd-desc { color: var(--muted); font-size: 25rpx; line-height: 1.7; margin: 13.46rpx 0 32.69rpx; }
.pd-price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 26.92rpx;
  padding-bottom: 30.77rpx;
  border-bottom: 1.92rpx solid var(--line);
}
.pd-price { color: var(--sage-deep); font-family: "Noto Serif SC", "Songti SC", serif; font-size: 57.69rpx; font-weight: 900; line-height: 1; }
.pd-price-unit { margin-left: 7.69rpx; color: var(--muted); font-family: "Noto Sans SC", "PingFang SC", sans-serif; font-size: 21.15rpx; font-weight: 600; }
.pd-seal { text-align: right; color: var(--sage-deep); }
.pd-seal-strong { font-size: 30.77rpx; font-weight: 900; line-height: 1.2; }
.pd-seal-span { color: var(--muted); font-size: 19.23rpx; }

.pd-section { padding: 32.69rpx 0; border-bottom: 1.92rpx solid var(--line); }
.pd-section-last { border-bottom: 0; }
.pd-section-title { font-size: 26.92rpx; font-weight: 800; margin-bottom: 21.15rpx; }
.pd-clue-card { padding: 4rpx 23rpx; border-radius: 18rpx; background: var(--paper); border: 2rpx solid var(--line); }
.pd-clue-row { display: flex; align-items: center; gap: 20rpx; min-height: 74rpx; border-bottom: 2rpx dashed var(--line); }
.pd-clue-row:last-child { border-bottom: 0; }
.pd-clue-label { width: 108rpx; flex-shrink: 0; color: var(--muted); font-size: 19rpx; }
.pd-clue-value { flex: 1; min-width: 0; color: var(--ink); font-size: 20rpx; font-weight: 700; line-height: 1.45; text-align: right; }
.pd-clue-hidden { color: var(--sage-deep); }
.pd-service-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15.38rpx; }
.pd-service-item {
  min-height: 146.15rpx;
  padding: 21.15rpx 15.38rpx;
  background: var(--paper);
  border-radius: 15.38rpx;
  text-align: center;
  box-shadow: 0 5.77rpx 19.23rpx rgba(60, 52, 44, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.pd-service-mark { color: var(--sage-deep); font-size: 25rpx; font-weight: 800; margin-bottom: 9.62rpx; }
.pd-service-text { color: var(--muted); font-size: 19.23rpx; line-height: 1.45; }
.pd-note { color: var(--muted); font-size: 21.15rpx; line-height: 1.75; }
.pd-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-top: 26rpx; }
.pd-step { min-width: 0; padding: 16rpx 13rpx 15rpx; border-radius: 15rpx; background: var(--paper); border: 2rpx solid var(--line); }
.pd-step-no { display: block; color: var(--sage-deep); font-size: 16rpx; font-weight: 800; letter-spacing: .08em; }
.pd-step-title { display: block; margin-top: 9rpx; font-size: 21rpx; font-weight: 800; }
.pd-step-copy { display: block; margin-top: 5rpx; color: var(--muted); font-size: 17rpx; line-height: 1.45; }

.pd-guide-entry {
  width: 100%;
  min-height: 130.77rpx;
  margin-top: 26.92rpx;
  padding: 21.15rpx 25rpx;
  display: flex;
  align-items: center;
  gap: 21.15rpx;
  border: 1.92rpx solid var(--sage-soft);
  border-radius: 15.38rpx;
  background: var(--sage-mist);
  color: var(--ink);
  box-sizing: border-box;
}
.pd-guide-icon {
  width: 76.92rpx;
  height: 76.92rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper);
  color: var(--sage-deep);
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 26.92rpx;
  font-weight: 900;
}
.pd-guide-copy { flex: 1; min-width: 0; }
.pd-guide-title { font-size: 25rpx; font-weight: 700; }
.pd-guide-sub { margin-top: 5.77rpx; color: var(--muted); font-size: 19.23rpx; line-height: 1.45; }
.pd-guide-arrow { font-size: 30.77rpx; }

.pd-offline { margin-top: 24rpx; padding: 18rpx; background: var(--cream-2); color: var(--muted); font-size: 21rpx; }
.pd-cart-row { margin-top: 26.92rpx; }
.pd-cart-btn {
  height: 76.92rpx;
  line-height: 76.92rpx;
  padding: 0 30.77rpx;
  border: 1.92rpx solid var(--sage);
  background: transparent;
  color: var(--sage-deep);
  border-radius: 999rpx;
  font-size: 23.08rpx;
  font-weight: 700;
}
.pd-cart-btn[disabled] { opacity: 0.45; }

.pd-actions-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 10;
  display: grid;
  grid-template-columns: 1fr 1.35fr;
  gap: 17.31rpx;
  padding: 21.15rpx 34.62rpx calc(23.08rpx + env(safe-area-inset-bottom));
  background: rgba(246, 241, 230, 0.96);
  border-top: 1.92rpx solid var(--line);
}
.pd-actions-bar .btn-block { margin: 0; }
.pd-actions-bar .btn-sage[disabled] { opacity: 0.45; }
.pd-saved { border-color: var(--sage); color: var(--sage-deep); }
.product-page .pd-body { padding-bottom: 219.23rpx; }
