<view class="login-page">
  <view class="login-hero">
    <image class="login-mascot" src="/assets/mascot/ai-dog.png" mode="aspectFit" />
    <view class="login-kicker">GOOD JOURNEY</view>
    <view class="login-title">登录途个惊喜</view>
    <view class="login-sub">行程、订单与旅行图鉴会跟着账号走</view>
  </view>
  <view class="login-card">
    <view class="field-label">手机号</view>
    <input class="login-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhone" />
    <view class="field-label">验证码</view>
    <view class="code-row">
      <input class="login-input code-input" type="number" maxlength="6" placeholder="6 位验证码" value="{{code}}" bindinput="onCode" />
      <button class="code-btn" bindtap="sendSms">获取验证码</button>
    </view>
    <button class="login-btn" bindtap="onSubmit">登录 / 注册</button>
    <view class="login-divider"><text>或</text></view>
    <button class="wx-login" open-type="chooseAvatar" bindchooseavatar="onWxChooseAvatar" hover-class="none">微信快捷登录</button>
    <view class="login-note">登录即代表同意隐私与用户服务说明</view>
  </view>
</view>
