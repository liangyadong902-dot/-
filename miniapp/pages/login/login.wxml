<view class="placeholder">
  <view>登录途个惊喜</view>
  <input type="number" maxlength="11" placeholder="手机号" value="{{phone}}" bindinput="onPhone" />
  <input type="number" maxlength="6" placeholder="验证码" value="{{code}}" bindinput="onCode" />
  <button bindtap="sendSms">获取验证码</button>
  <button class="login-btn" bindtap="onSubmit">登录 / 注册</button>
  <button class="wx-login" open-type="chooseAvatar" bindchooseavatar="onWxChooseAvatar" hover-class="none">微信快捷登录</button>
</view>
