.page-shell{min-height:100vh;background:var(--cream);padding-bottom:70rpx}.head{padding:88rpx 34rpx 40rpx;background:linear-gradient(180deg,#F7F7F7,var(--cream))}.kicker{display:block;color:var(--sage-deep);font-size:18rpx;letter-spacing:.16em}.title{display:block;margin-top:12rpx;font:900 46rpx/1.2 serif}.desc{display:block;margin-top:10rpx;color:var(--muted);font-size:21rpx}.content{padding:24rpx 28rpx}.notice,.section{padding:24rpx;background:var(--paper);border:1rpx solid var(--line);border-radius:18rpx}.notice{color:var(--muted);font-size:21rpx;line-height:1.6}.section{margin-top:18rpx}.label{display:block;font-weight:800;font-size:24rpx;margin-bottom:14rpx}.choice{padding:18rpx;border:1rpx solid var(--line);border-radius:12rpx;margin-top:10rpx;font-size:21rpx}.choice.active{background:var(--sage-mist);border-color:var(--sage);color:var(--sage-deep);font-weight:700}.sage{width:100%;height:78rpx;margin-top:24rpx;background:var(--sage-deep);color:#fff;border:0;border-radius:999rpx;font-size:24rpx}.state{min-height:48vh;display:grid;place-items:center;color:var(--muted)}
