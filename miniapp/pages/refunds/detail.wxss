.page-shell{min-height:100vh;background:var(--cream);padding-bottom:70rpx}.head{padding:88rpx 34rpx 40rpx;background:linear-gradient(180deg,#e3edd6,var(--cream))}.kicker{display:block;color:var(--sage-deep);font-size:18rpx;letter-spacing:.16em}.title{display:block;margin-top:12rpx;font:900 46rpx/1.2 serif}.desc{display:block;margin-top:10rpx;color:var(--muted);font-size:20rpx}.content{padding:24rpx 28rpx}.ticket{padding:28rpx;background:var(--paper);border:1rpx solid var(--line);border-radius:20rpx}.row,.line{display:flex;justify-content:space-between;gap:18rpx}.name{font-weight:800;font-size:27rpx}.status{color:var(--sage-deep)}.line{margin-top:24rpx;color:var(--muted);font-size:20rpx}.price{color:var(--ink);font-size:28rpx;font-weight:800}.reject{margin-top:20rpx;padding:16rpx;background:#fbebe5;color:#a75e4b;border-radius:12rpx;font-size:20rpx}.state{min-height:48vh;display:grid;place-items:center;color:var(--muted)}
