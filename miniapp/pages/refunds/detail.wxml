<view class="page-shell"><view class="head"><text class="kicker">退款进度</text><text class="title">退款详情</text><text class="desc">{{refund ? refund.refundNo : orderNo}}</text></view><view wx:if="{{loading}}" class="state">正在读取退款进度…</view><view wx:elif="{{error}}" class="state">{{error}}</view><view wx:else class="content"><view class="ticket"><view class="row"><text class="name">{{refund.boxName || refund.orderNo}}</text><text class="status">{{refund.status}}</text></view><view class="line"><text>退款金额</text><text class="price">¥{{refund.amountText}}</text></view><view class="line"><text>申请原因</text><text>{{refund.reason}}</text></view><view class="line"><text>提交时间</text><text>{{refund.createdAt}}</text></view><view wx:if="{{refund.rejectReason}}" class="reject">驳回原因：{{refund.rejectReason}}</view></view></view></view>

<tuge-overlay />
