<view class="page-shell"><view class="head"><text class="kicker">REFUND REQUEST</text><text class="title">申请退款</text><text class="desc">{{order ? order.boxName : orderNo}}</text></view><view wx:if="{{loading}}" class="state">正在检查退款资格…</view><view wx:elif="{{error}}" class="state">{{error}}</view><view wx:else class="content"><view class="notice">退款会由服务端校验订单和行程状态，提交后可在退款详情查看进度。</view><view class="section"><text class="label">退款类型</text><view class="choice {{kind === 'unused' ? 'active' : ''}}" data-kind="unused" bindtap="pickKind">未出行退换</view><view class="choice {{kind === 'value_guard' ? 'active' : ''}}" data-kind="value_guard" bindtap="pickKind">行程价值不符</view></view><view class="section"><text class="label">申请原因</text><view wx:for="{{reasons}}" wx:key="*this" class="choice {{reason === item ? 'active' : ''}}" data-reason="{{item}}" bindtap="pickReason">{{item}}</view></view><button class="sage" bindtap="submit">{{submitting ? '提交中…' : '提交退款申请'}}</button></view></view>
