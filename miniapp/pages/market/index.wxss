.market-page{min-height:100vh;background:var(--cream)}.market-head{padding:72rpx 34rpx 38rpx;background:linear-gradient(180deg,#e3edd6,var(--cream))}.kicker{color:var(--sage-deep);letter-spacing:.16em;font-size:18rpx}.title{margin-top:14rpx;font-family:serif;font-size:44rpx;font-weight:900}.desc{margin-top:12rpx;color:var(--muted);font-size:21rpx}.filters{padding:16rpx 34rpx 22rpx;white-space:nowrap}.filter{display:inline-block;padding:10rpx 20rpx;margin-right:10rpx;border:1rpx solid var(--line);border-radius:999rpx;background:var(--paper);color:var(--muted);font-size:21rpx}.filter.active{background:var(--sage-mist);border-color:var(--sage);color:var(--sage-deep)}.state{min-height:50vh;display:grid;place-items:center;color:var(--muted)}.box-grid{padding:0 28rpx 50rpx;display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.box-card{background:var(--paper);border:1rpx solid var(--line);border-radius:16rpx;overflow:hidden}.box-card image{width:100%;height:250rpx}.box-copy{padding:16rpx}.box-name{font-size:25rpx;font-weight:800}.box-intro{margin-top:7rpx;color:var(--muted);font-size:19rpx;line-height:1.4}.box-price{margin-top:14rpx;color:var(--sage-deep);font-size:26rpx;font-weight:800}.box-price text{margin-left:8rpx;color:var(--muted);font-size:17rpx;font-weight:400}
