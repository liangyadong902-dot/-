<view class="market-page"><view class="market-head"><view class="kicker">THE JOURNEY SHELF</view><view class="title">商品广场</view><view class="desc">先挑一种心情，再决定从哪里出发。</view></view><scroll-view class="filters" scroll-x show-scrollbar="{{false}}"><view wx:for="{{['all','nearby','province','cross','theme']}}" wx:key="*this" class="filter {{category===item?'active':''}}" data-category="{{item}}" bindtap="filter">{{item==='all'?'全部':item==='nearby'?'周边游':item==='province'?'省内游':item==='cross'?'跨省游':'主题盒'}}</view></scroll-view><scroll-view class="filters price-filters" scroll-x show-scrollbar="{{false}}"><view wx:for="{{bands}}" wx:key="key" class="filter {{priceBand===item.key?'active':''}}" data-band="{{item.key}}" bindtap="pickBand">{{item.label}}</view></scroll-view><view wx:if="{{loading}}" class="state">正在整理货架…</view><view wx:elif="{{!list.length}}" class="state">暂时没有可售盲盒</view><view wx:else class="box-grid"><view wx:for="{{list}}" wx:key="id" class="box-card" data-id="{{item.id}}" bindtap="open"><image src="{{item.coverUrl}}" mode="aspectFill"/><view class="box-copy"><view class="box-name">{{item.name}}</view><view class="box-intro">{{item.intro}}</view><view class="box-price">¥{{item.price}}</view></view></view></view><view class="tab-safe"></view></view>

<tuge-overlay />
