.page{min-height:100vh;padding:100rpx 34rpx 50rpx;background:var(--cream);color:var(--ink)}.bar{color:var(--muted);margin-bottom:22rpx}.strong{font-size:40rpx;font-weight:900;color:var(--sage-deep)}.result{background:var(--sage-mist);color:var(--sage-deep);border-radius:20rpx;padding:20rpx;margin-bottom:20rpx}.hint{color:var(--muted);text-align:center;padding:120rpx 0;font-size:23rpx}.list{display:flex;flex-direction:column;gap:20rpx}.card{background:var(--paper);border-radius:26rpx;padding:26rpx;box-shadow:0 8rpx 28rpx rgba(60,52,44,.06)}.name{font-family:"Noto Serif SC",serif;font-weight:800;font-size:30rpx}.desc{color:var(--muted);font-size:22rpx;margin-top:9rpx;line-height:1.5}.meta{color:var(--muted);font-size:21rpx;margin-top:9rpx}.btn{margin-top:22rpx;background:var(--sage);color:#fff;border:0;border-radius:999rpx}
