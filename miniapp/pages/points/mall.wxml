<view class="page">
  <view class="bar">当前积分 <text class="strong">{{balance}}</text></view>
  <view wx:if="{{result}}" class="result" bindtap="openCoupon">兑换成功：{{result.couponName}} · 已放入卡包 ›</view>
  <view wx:if="{{loading}}" class="hint">加载中...</view>
  <view wx:elif="{{error}}" class="hint" bindtap="retry">{{error}}</view>
  <view wx:elif="{{empty}}" class="hint">暂无可兑换商品</view>
  <view wx:else class="list">
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="name">{{item.name}}</view>
      <view class="desc">{{item.description}}</view>
      <view class="meta">{{item.pointsCost}} 积分 · 剩余 {{item.remainStock}} · 限兑 {{item.limitPerUser}}</view>
      <button class="btn" disabled="{{submitting}}" data-id="{{item.id}}" bindtap="exchange">{{submitting ? '提交中...' : '立即兑换'}}</button>
    </view>
  </view>
</view>
