.page{min-height:100vh;padding:100rpx 34rpx 50rpx;background:var(--cream);color:var(--ink)}.hint{color:var(--muted);text-align:center;padding:120rpx 0;font-size:23rpx}.list{display:flex;flex-direction:column}.row{display:flex;justify-content:space-between;align-items:center;background:var(--paper);border-radius:20rpx;padding:25rpx;margin-bottom:16rpx;box-shadow:0 6rpx 20rpx rgba(60,52,44,.04)}.desc{color:var(--ink);font-size:25rpx}.time{color:var(--muted);font-size:20rpx;margin-top:7rpx}.amt{font-size:30rpx;font-weight:800}.plus{color:var(--sage-deep)}.minus{color:#c66}.more{color:var(--muted);text-align:center;padding:16rpx}
