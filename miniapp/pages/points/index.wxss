.page{min-height:100vh;padding:100rpx 34rpx 50rpx;background:var(--cream);color:var(--ink)}.hint{color:var(--muted);text-align:center;padding:120rpx 0;font-size:23rpx}.card{background:var(--paper);border-radius:26rpx;padding:34rpx;text-align:center;box-shadow:0 8rpx 28rpx rgba(60,52,44,.06)}.balance{font-family:"Noto Serif SC",serif;font-size:64rpx;font-weight:900;color:var(--sage-deep)}.label{color:var(--muted);margin-bottom:18rpx}.row{color:var(--muted);font-size:23rpx;margin-top:10rpx}.btn{margin-top:28rpx;background:var(--sage-deep);color:#fff;border:0;border-radius:999rpx}.links{margin-top:24rpx;display:flex;flex-direction:column;gap:16rpx}.link{background:var(--paper);border-radius:20rpx;padding:25rpx 28rpx;color:var(--ink);box-shadow:0 6rpx 20rpx rgba(60,52,44,.04)}
