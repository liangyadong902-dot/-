.chat-page { height:100vh; box-sizing:border-box; display:flex; flex-direction:column; background:#fff; }

/* ── 自绘导航 ── */
.cnav { position:fixed; top:0; left:0; right:0; background:#fff; z-index:20; box-sizing:border-box; }
.cnav-row { position:relative; height:44px; display:flex; align-items:center; padding:0 8px; }
.cnav-back { height:100%; display:flex; align-items:center; padding:0 22rpx 0 14rpx; }
.ic-back { width:20rpx; height:20rpx; border-left:5rpx solid #222; border-bottom:5rpx solid #222; transform:rotate(45deg); }
.cnav-avatar { width:64rpx; height:64rpx; border-radius:50%; background:#F5F5F5; margin-left:4rpx; }
.cnav-avatar-fb { display:flex; align-items:center; justify-content:center; background:#EFE9DC; color:#B8A88A; font-weight:900; font-size:28rpx; }
.cnav-name { margin-left:14rpx; font-size:30rpx; font-weight:700; color:#222; max-width:300rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.cnav-more { position:absolute; color:#222; font-size:30rpx; font-weight:900; letter-spacing:2rpx; }

/* ── 消息区 ── */
.chat-scroll { flex:1; min-height:0; }
.chat-list { padding:20rpx 28rpx 0; display:flex; flex-direction:column; gap:20rpx; }
.chat-pad { height:30rpx; }

/* 居中时间分割（小红书式） */
.time-divider { text-align:center; color:#B2B2B2; font-size:22rpx; padding:10rpx 0 2rpx; }

.msg-row { display:flex; align-items:flex-start; gap:16rpx; }
.msg-row.mine { flex-direction:row-reverse; }
.m-avatar { width:76rpx; height:76rpx; border-radius:50%; background:#F5F5F5; flex-shrink:0; }
.m-avatar-fb { display:flex; align-items:center; justify-content:center; color:#B8A88A; font-weight:900; font-size:26rpx; background:#EFE9DC; }

/* 气泡：自己蓝底白字、对方浅灰 */
.m-bubble { max-width:70%; background:#F5F5F5; color:#222; border-radius:24rpx; padding:18rpx 26rpx; font-size:29rpx; line-height:1.5; word-break:break-all; }
.msg-row.mine .m-bubble { background:#3E7BFA; color:#fff; }

/* 图片消息：圆角直出 */
.m-image { width:320rpx; border-radius:16rpx; background:#F5F5F5; }

.empty-hint { padding:160rpx 40rpx; text-align:center; color:#999; font-size:23rpx; }

/* ── 底部：快捷表情条 + 输入栏 ── */
.chat-footer { background:#fff; }
.quick-bar { white-space:nowrap; }
.quick-inner { display:inline-flex; gap:14rpx; padding:10rpx 24rpx; }
.quick-chip { display:inline-flex; align-items:center; gap:8rpx; background:#F6F6F6; border-radius:999rpx; padding:10rpx 22rpx; }
.chip-hover { background:#ECECEC; }
.qc-emoji { font-size:30rpx; line-height:1; }
.qc-text { font-size:23rpx; color:#333; }

.chat-bar { display:flex; align-items:center; gap:16rpx; padding:12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); }
.input-pill { flex:1; min-width:0; display:flex; align-items:center; background:#F5F5F5; border-radius:999rpx; height:76rpx; padding:0 20rpx 0 28rpx; }
.chat-input { flex:1; min-width:0; height:76rpx; line-height:76rpx; font-size:27rpx; color:#222; }
.input-ph { color:#BBB; }
.pill-emoji { flex-shrink:0; font-size:40rpx; line-height:1; padding:6rpx; }
.pill-emoji.on { opacity:.55; }
.plus-btn { flex-shrink:0; width:64rpx; height:64rpx; display:flex; align-items:center; justify-content:center; }
.ic-plus { position:relative; width:34rpx; height:34rpx; border:4rpx solid #555; border-radius:50%; box-sizing:border-box; }
.ic-plus::before, .ic-plus::after { content:''; position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); background:#555; border-radius:2rpx; }
.ic-plus::before { width:16rpx; height:3rpx; }
.ic-plus::after { width:3rpx; height:16rpx; }
.send-btn { flex-shrink:0; height:64rpx; line-height:64rpx; padding:0 28rpx; border-radius:999rpx; background:#FF2442; color:#fff; font-size:24rpx; font-weight:700; }
.send-btn.dim { opacity:.5; }
