.msg-page { min-height:100vh; background:var(--cream); padding-bottom:60rpx; }
.msg-tabs { display:flex; gap:14rpx; padding:26rpx 34rpx 0; }
.msg-tab { position:relative; padding:14rpx 34rpx; border-radius:999rpx; background:var(--paper); border:1rpx solid var(--line); color:var(--muted); font-size:24rpx; font-weight:700; }
.msg-tab.on { background:var(--sage); color:#fff; border-color:var(--sage); }
.tab-badge { position:absolute; top:-10rpx; right:-8rpx; min-width:34rpx; height:34rpx; line-height:34rpx; padding:0 8rpx; border-radius:999rpx; background:#e5484d; color:#fff; font-size:18rpx; text-align:center; }
.notice-actions { padding:20rpx 34rpx 0; display:flex; justify-content:flex-end; }
.mark-all { color:var(--sage-deep); font-size:21rpx; padding:8rpx 20rpx; border:1rpx solid var(--sage-deep); border-radius:999rpx; }
.notice-list { padding:20rpx 34rpx; display:flex; flex-direction:column; gap:16rpx; }
.notice-item { display:flex; align-items:center; gap:18rpx; background:var(--paper); border:1rpx solid var(--line); border-radius:18rpx; padding:20rpx; }
.notice-item.unread { background:#fbf7ec; }
.n-avatar-wrap { position:relative; flex-shrink:0; }
.n-avatar { width:84rpx; height:84rpx; border-radius:50%; background:var(--cream); }
.n-avatar-fb { display:flex; align-items:center; justify-content:center; color:var(--sage-deep); font-weight:900; font-size:32rpx; }
.n-type { position:absolute; left:50%; bottom:-10rpx; transform:translateX(-50%); background:var(--sage-deep); color:#fff; font-size:16rpx; padding:2rpx 10rpx; border-radius:999rpx; white-space:nowrap; }
.n-body { flex:1; min-width:0; }
.n-line { font-size:23rpx; line-height:1.5; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
.n-actor { font-weight:800; margin-right:10rpx; }
.n-content { color:var(--muted); }
.n-time { margin-top:8rpx; color:var(--muted); font-size:19rpx; }
.n-dot { width:16rpx; height:16rpx; border-radius:50%; background:#e5484d; flex-shrink:0; }
.conv-list { padding:20rpx 34rpx; display:flex; flex-direction:column; gap:16rpx; }
.conv-item { display:flex; align-items:center; gap:18rpx; background:var(--paper); border:1rpx solid var(--line); border-radius:18rpx; padding:20rpx; }
.c-avatar-wrap { position:relative; flex-shrink:0; }
.c-avatar { width:92rpx; height:92rpx; border-radius:50%; background:var(--cream); }
.c-avatar-fb { display:flex; align-items:center; justify-content:center; color:var(--sage-deep); font-weight:900; font-size:34rpx; }
.c-badge { position:absolute; top:-8rpx; right:-8rpx; min-width:32rpx; height:32rpx; line-height:32rpx; padding:0 8rpx; border-radius:999rpx; background:#e5484d; color:#fff; font-size:18rpx; text-align:center; }
.c-body { flex:1; min-width:0; }
.c-row { display:flex; justify-content:space-between; align-items:center; }
.c-name { font-size:25rpx; font-weight:800; }
.c-time { color:var(--muted); font-size:19rpx; }
.c-last { margin-top:8rpx; color:var(--muted); font-size:21rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.empty-hint { padding:120rpx 40rpx; text-align:center; color:var(--muted); font-size:22rpx; }
