.page { min-height:100vh; background:var(--cream, #F6F1E6); }

/* ── 自绘导航 ── */
.nav {
  position:fixed; top:0; left:0; right:0; z-index:20; box-sizing:border-box;
  /* 与 AI 搭子页 cloud-head 同款背景：云朵气泡 + 鼠尾草绿渐变 */
  background:
    radial-gradient(80.77rpx 53.85rpx at 6% 0%, #f7faf3 0 62%, transparent 63%),
    radial-gradient(96.15rpx 61.54rpx at 22% -4%, #eef5e5 0 64%, transparent 65%),
    radial-gradient(107.69rpx 65.38rpx at 48% -6%, #f8fbf5 0 60%, transparent 61%),
    radial-gradient(88.46rpx 57.69rpx at 74% -2%, #eaf2df 0 64%, transparent 65%),
    radial-gradient(100rpx 61.54rpx at 96% 2%, #f3f7ec 0 62%, transparent 63%),
    linear-gradient(180deg, #E3EDD6 0%, #E8F0DC 100%);
}
.nav-row { position:relative; height:44px; display:flex; align-items:center; justify-content:center; }
.nav-title { font-size:34rpx; font-weight:800; color:#222; }
.nav-icons { position:absolute; display:flex; align-items:center; gap:30rpx; }
.nav-btn { width:52rpx; height:52rpx; display:flex; align-items:center; justify-content:center; }
.ic-search { position:relative; width:30rpx; height:30rpx; border:4rpx solid #222; border-radius:50%; box-sizing:border-box; }
.ic-search::after { content:''; position:absolute; right:-8rpx; bottom:-7rpx; width:15rpx; height:4rpx; background:#222; border-radius:2rpx; transform:rotate(45deg); }
.ic-search.sm { width:26rpx; height:26rpx; flex-shrink:0; }
.ic-plus { position:relative; width:34rpx; height:34rpx; border:4rpx solid #222; border-radius:50%; box-sizing:border-box; }
.ic-plus::before, .ic-plus::after { content:''; position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); background:#222; border-radius:2rpx; }
.ic-plus::before { width:16rpx; height:3rpx; }
.ic-plus::after { width:3rpx; height:16rpx; }

/* ── 搜索行 ── */
.search-row { display:flex; align-items:center; gap:20rpx; padding:16rpx 34rpx; }
.search-pill { flex:1; min-width:0; display:flex; align-items:center; gap:14rpx; background:#F5F5F5; border-radius:999rpx; height:68rpx; padding:0 24rpx; }
.search-input { flex:1; min-width:0; height:68rpx; line-height:68rpx; font-size:25rpx; color:#333; }
.search-cancel { flex-shrink:0; color:#666; font-size:25rpx; }
.input-ph { color:#BBB; }

/* ── 三个互动入口卡片（圆角方块+自绘图标） ── */
.quick-row { display:flex; padding:34rpx 60rpx 30rpx; justify-content:space-between; }
.quick { display:flex; flex-direction:column; align-items:center; gap:14rpx; }
.q-icon { position:relative; width:118rpx; height:118rpx; border-radius:38rpx; display:flex; align-items:center; justify-content:center; }
.qi-like { background:linear-gradient(180deg, #FFEBE7, #FFDCD7); }
.qi-follow { background:linear-gradient(180deg, #E9F2FF, #DBE9FF); }
.qi-comment { background:linear-gradient(180deg, #E4F8EC, #D5F2E0); }
.q-badge { position:absolute; top:-10rpx; right:-10rpx; min-width:34rpx; height:34rpx; line-height:34rpx; padding:0 8rpx; border-radius:999rpx; background:#FF2442; color:#fff; font-size:19rpx; text-align:center; border:3rpx solid #fff; box-sizing:border-box; }
.q-label { font-size:25rpx; color:#222; }

/* 红心 */
.sh-heart { position:relative; width:32rpx; height:32rpx; background:#FF4B55; transform:rotate(45deg); border-radius:5rpx; margin-top:-8rpx; }
.sh-heart::before, .sh-heart::after { content:''; position:absolute; width:32rpx; height:32rpx; background:#FF4B55; border-radius:50%; }
.sh-heart::before { left:-16rpx; }
.sh-heart::after { top:-16rpx; }
/* 人形 */
.sh-person { position:relative; width:50rpx; height:50rpx; }
.sh-person::before { content:''; position:absolute; left:50%; top:0; transform:translateX(-50%); width:22rpx; height:22rpx; border-radius:50%; background:#3E7BFA; }
.sh-person::after { content:''; position:absolute; left:50%; bottom:0; transform:translateX(-50%); width:44rpx; height:26rpx; border-radius:26rpx 26rpx 6rpx 6rpx; background:#3E7BFA; }
/* 对话气泡 */
.sh-bubble { position:relative; width:50rpx; height:38rpx; background:#2FBF71; border-radius:12rpx; margin-bottom:6rpx; }
.sh-bubble::before { content:''; position:absolute; left:12rpx; top:15rpx; width:6rpx; height:6rpx; border-radius:50%; background:#fff; box-shadow:12rpx 0 0 #fff; }
.sh-bubble::after { content:''; position:absolute; left:8rpx; bottom:-8rpx; border-left:10rpx solid #2FBF71; border-bottom:10rpx solid transparent; }

/* ── 私信会话列表（通栏行，未读红点在右侧） ── */
.conv-list { display:flex; flex-direction:column; padding-top:8rpx; }
.conv-item { display:flex; align-items:center; gap:24rpx; padding:22rpx 34rpx; }
.row-hover { background:#F8F8F8; }
.avatar-wrap { position:relative; flex-shrink:0; }
.avatar { width:110rpx; height:110rpx; border-radius:50%; background:#F5F5F5; }
.avatar-sm { width:92rpx; height:92rpx; }
.avatar-fb { display:flex; align-items:center; justify-content:center; background:#EFE9DC; color:#B8A88A; font-weight:900; font-size:38rpx; }
.conv-main { flex:1; min-width:0; }
.conv-name { font-size:29rpx; font-weight:700; color:#222; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.conv-last { margin-top:10rpx; color:#999; font-size:24rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.conv-side { flex-shrink:0; display:flex; flex-direction:column; align-items:flex-end; gap:14rpx; }
.conv-time { color:#A6A6A6; font-size:22rpx; }
.conv-dot { width:16rpx; height:16rpx; border-radius:50%; background:#FF2442; }

/* ── 二级通知列表 ── */
.sub-nav { display:flex; align-items:center; padding:20rpx 30rpx 16rpx; }
.back-btn { width:64rpx; height:64rpx; line-height:60rpx; text-align:center; font-size:52rpx; color:#222; font-weight:700; margin-left:-14rpx; }
.sub-title { flex:1; font-size:34rpx; font-weight:900; color:#222; }
.read-all { color:#FF2442; font-size:23rpx; font-weight:600; padding:8rpx 4rpx; }
.notice-list { display:flex; flex-direction:column; }
.notice-item { display:flex; align-items:center; gap:20rpx; padding:22rpx 34rpx; }
.notice-item.read { opacity:.45; }
.notice-main { flex:1; min-width:0; }
.notice-line { font-size:25rpx; line-height:1.55; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; color:#222; }
.n-actor { font-weight:800; }
.n-action { color:#666; }
.n-content { color:#999; }
.n-time { margin-top:8rpx; color:#A6A6A6; font-size:20rpx; }
.n-cover { width:110rpx; height:110rpx; border-radius:12rpx; background:#F5F5F5; flex-shrink:0; }
.red-dot { position:absolute; top:0; right:0; width:18rpx; height:18rpx; border-radius:50%; background:#FF2442; box-shadow:0 0 0 4rpx #fff; }

.empty-hint { padding:120rpx 40rpx; text-align:center; color:#999; font-size:23rpx; }

/* ── AI搭子置顶入口 ── */
.ai-pin { display:flex; align-items:center; gap:22rpx; margin:8rpx 24rpx 0; padding:20rpx 24rpx; background:transparent; border-bottom:2rpx solid #EAE2D4; border-radius:0; }
.ai-pin-ava { width:92rpx; height:92rpx; border-radius:50%; background:#FFFDF8; overflow:hidden; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
.ai-pin-ava image { width:100%; height:100%; }
.ai-pin-main { flex:1; min-width:0; }
.ai-pin-name { display:flex; align-items:center; gap:12rpx; font-size:29rpx; font-weight:800; color:#222; }
.ai-pin-tag { flex-shrink:0; font-size:19rpx; font-weight:600; color:#5E7147; background:#E3EDD6; border-radius:8rpx; padding:2rpx 12rpx; }
.ai-pin-last { margin-top:6rpx; font-size:24rpx; color:#8A9484; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.ai-pin-chevron { flex-shrink:0; color:#C8CFC0; font-size:40rpx; line-height:1; }
