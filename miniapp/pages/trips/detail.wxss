.trip-page { min-height: 100vh; background: var(--cream); padding-bottom: calc(54rpx + env(safe-area-inset-bottom)); }
.state { min-height: 72vh; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 23rpx; }
.trip-hero { position: relative; height: 365rpx; overflow: hidden; background: var(--cream-2); color: #fff; }
.trip-hero-empty { background: linear-gradient(145deg, #9aaf88, #657753); }
.trip-cover { width: 100%; height: 100%; }
.trip-cover-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(31,27,23,.04), rgba(31,27,23,.74)); }
.trip-hero-copy { position: absolute; left: 35rpx; right: 35rpx; bottom: 34rpx; display: flex; flex-direction: column; }
.trip-kicker { font-size: 18rpx; font-weight: 700; letter-spacing: .13em; opacity: .88; }
.trip-title { margin-top: 12rpx; font-family: "Noto Serif SC", "Songti SC", serif; font-size: 44rpx; font-weight: 900; line-height: 1.28; }
.trip-place { margin-top: 12rpx; font-size: 21rpx; opacity: .92; }
.trip-body { padding: 22rpx 34rpx 0; }
.trip-pills { width: 100%; white-space: nowrap; margin-bottom: 23rpx; }
.trip-pill { display: inline-flex; align-items: center; height: 48rpx; padding: 0 17rpx; margin-right: 11rpx; border-radius: 999rpx; background: var(--sage-mist); color: var(--sage-deep); font-size: 18rpx; font-weight: 700; }
.blindbox-ticket { position: relative; display: flex; align-items: center; gap: 18rpx; min-height: 105rpx; margin-bottom: 23rpx; padding: 20rpx 22rpx; overflow: hidden; border: 2rpx dashed var(--sage); border-radius: 22rpx; background: linear-gradient(110deg, #f6f2e7, #edf4e5); box-sizing: border-box; }
.blindbox-ticket::after { content: ""; position: absolute; right: -25rpx; top: -34rpx; width: 110rpx; height: 110rpx; border: 2rpx solid rgba(108,126,88,.14); border-radius: 50%; }
.blindbox-stamp { width: 62rpx; height: 62rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 3rpx solid var(--sage-deep); border-radius: 50%; color: var(--sage-deep); font-size: 17rpx; font-weight: 900; transform: rotate(-9deg); }
.blindbox-ticket-copy { flex: 1; min-width: 0; }
.blindbox-ticket-title { color: var(--ink); font-size: 23rpx; font-weight: 800; line-height: 1.4; }
.blindbox-ticket-sub { margin-top: 7rpx; color: var(--muted); font-size: 17rpx; }
.blindbox-badge { position: relative; z-index: 1; flex-shrink: 0; padding: 7rpx 11rpx; border-radius: 999rpx; background: var(--sage-deep); color: #fff; font-size: 16rpx; }
.value-card { position: relative; display: flex; align-items: center; min-height: 128rpx; padding: 21rpx 24rpx; border: 2rpx solid var(--line); border-radius: 24rpx; background: var(--paper); box-shadow: 0 8rpx 24rpx rgba(60,52,44,.04); }
.value-item { flex: 1; display: flex; flex-direction: column; }
.value-item text { color: var(--muted); font-size: 18rpx; }
.value-amount { margin-top: 6rpx; color: var(--ink); font-size: 29rpx; font-weight: 800; }
.value-divider { width: 2rpx; height: 54rpx; margin: 0 25rpx; background: var(--line); }
.value-status { position: absolute; top: 17rpx; right: 20rpx; padding: 5rpx 12rpx; border-radius: 999rpx; background: var(--sage-mist); color: var(--sage-deep); font-size: 16rpx; font-weight: 700; }
.trip-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 17rpx; border: 2rpx solid var(--line); border-radius: 20rpx; overflow: hidden; background: var(--paper); }
.trip-fact { min-height: 76rpx; padding: 14rpx 18rpx; border-right: 2rpx solid var(--line); border-bottom: 2rpx solid var(--line); box-sizing: border-box; }
.trip-fact:nth-child(2n) { border-right: 0; }
.trip-fact:nth-last-child(-n + 2) { border-bottom: 0; }
.trip-fact-label { display: block; color: var(--muted); font-size: 16rpx; }
.trip-fact-value { display: block; margin-top: 5rpx; color: var(--ink); font-size: 19rpx; font-weight: 700; line-height: 1.4; }
.trip-section { margin-top: 36rpx; }
.section-eyebrow { color: var(--sage-deep); font-size: 17rpx; font-weight: 700; letter-spacing: .13em; }
.section-title { font-family: "Noto Serif SC", "Songti SC", serif; font-size: 29rpx; font-weight: 900; }
.highlight-section .section-title { margin-top: 6rpx; }
.highlight-quote { margin-top: 18rpx; color: var(--sage-deep); font-family: "Noto Serif SC", "Songti SC", serif; font-size: 27rpx; font-weight: 800; line-height: 1.6; }
.section-copy { margin-top: 10rpx; color: var(--muted); font-size: 21rpx; line-height: 1.75; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; margin-bottom: 17rpx; }
.section-note { flex-shrink: 0; color: var(--muted); font-size: 18rpx; }
.trip-detail-route { padding: 27rpx 26rpx 8rpx; border: 2rpx solid var(--line); border-radius: 25rpx; background: var(--paper); }
.trip-timeline { position: relative; padding-left: 50rpx; }
.trip-timeline::before { content: ""; position: absolute; left: 13rpx; top: 13rpx; bottom: 26rpx; width: 2rpx; background: var(--sage-soft); }
.trip-stop { position: relative; padding-bottom: 29rpx; }
.trip-stop::before { content: ""; position: absolute; left: -48rpx; top: 8rpx; width: 18rpx; height: 18rpx; border: 4rpx solid var(--sage-deep); border-radius: 50%; background: var(--paper); }
.trip-stop-time { display: block; margin-bottom: 5rpx; color: var(--sage-deep); font-size: 18rpx; font-weight: 800; }
.trip-stop-title { margin-bottom: 7rpx; font-size: 23rpx; font-weight: 800; }
.trip-stop-desc { color: var(--muted); font-size: 19rpx; line-height: 1.65; }
.trip-attractions { border-top: 2rpx solid var(--line); }
.trip-attraction { padding: 20rpx 0; border-bottom: 2rpx solid var(--line); }
.trip-attraction:last-child { border-bottom: 0; }
.attraction-top { display: flex; justify-content: space-between; gap: 18rpx; margin-bottom: 8rpx; font-size: 22rpx; font-weight: 800; }
.attraction-duration { flex-shrink: 0; color: var(--sage-deep); font-size: 17rpx; }
.empty-detail { padding: 23rpx 0; border-top: 2rpx solid var(--line); color: var(--muted); font-size: 19rpx; }
.logistics-section { padding: 26rpx; border: 2rpx solid var(--line); border-radius: 25rpx; background: var(--paper); }
.detail-row { display: flex; align-items: flex-start; gap: 16rpx; padding: 17rpx 0; border-bottom: 2rpx solid var(--line); }
.detail-row:last-child { border-bottom: 0; }
.detail-row-icon { width: 42rpx; height: 42rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--sage-mist); color: var(--sage-deep); font-size: 23rpx; font-weight: 900; }
.detail-row-copy { flex: 1; min-width: 0; }
.detail-row-title { color: var(--ink); font-size: 21rpx; font-weight: 800; line-height: 1.45; }
.detail-row-desc { margin-top: 5rpx; color: var(--muted); font-size: 18rpx; line-height: 1.65; }
.guide-entry { width: 100%; min-height: 116rpx; margin: 35rpx 0 0; padding: 19rpx 22rpx; display: flex; align-items: center; gap: 17rpx; border: 0; border-radius: 23rpx; background: var(--sage-deep); color: #fff; text-align: left; box-shadow: 0 10rpx 25rpx rgba(108,126,88,.16); }
.guide-entry-icon { width: 54rpx; height: 54rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.2); font-size: 30rpx; }
.guide-entry-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.guide-entry-copy text { font-size: 23rpx; font-weight: 800; line-height: 1.35; }
.guide-entry-sub { margin-top: 6rpx; font-size: 17rpx; opacity: .84; line-height: 1.4; }
.guide-entry-chev { flex-shrink: 0; font-size: 39rpx; line-height: 1; }
.cost-card { padding: 7rpx 23rpx; border: 2rpx solid var(--line); border-radius: 22rpx; background: var(--paper); }
.cost-row { display: flex; align-items: center; justify-content: space-between; gap: 17rpx; padding: 19rpx 0; border-bottom: 2rpx solid var(--line); }
.cost-row:last-child { border-bottom: 0; }
.cost-label { color: var(--ink); font-size: 20rpx; }
.cost-note { margin-left: 11rpx; color: var(--muted); font-size: 16rpx; }
.cost-value { flex-shrink: 0; color: var(--sage-deep); font-size: 21rpx; font-weight: 800; }
.include-section { padding: 26rpx; border: 2rpx solid var(--line); border-radius: 25rpx; background: var(--paper); }
.include-item { display: flex; align-items: flex-start; gap: 13rpx; padding: 12rpx 0; color: var(--muted); font-size: 20rpx; line-height: 1.55; }
.include-mark { width: 30rpx; height: 30rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--sage-mist); color: var(--sage-deep); font-size: 18rpx; font-weight: 900; }
.prepare-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 13rpx; }
.prepare-chip { display: flex; align-items: center; gap: 9rpx; min-height: 62rpx; padding: 10rpx 13rpx; border: 2rpx solid var(--line); border-radius: 15rpx; background: var(--paper); color: var(--muted); font-size: 18rpx; line-height: 1.35; box-sizing: border-box; }
.prepare-check { width: 25rpx; height: 25rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--sage-mist); color: var(--sage-deep); font-size: 16rpx; font-weight: 900; }
.weather-card { display: flex; align-items: flex-start; gap: 15rpx; padding: 20rpx; border-radius: 17rpx; background: var(--sage-mist); color: var(--muted); font-size: 19rpx; line-height: 1.65; }
.weather-icon { flex-shrink: 0; color: var(--sage-deep); font-size: 30rpx; line-height: 1.2; }
.planb-row { display: flex; align-items: flex-start; gap: 13rpx; padding: 17rpx 0 0; color: var(--muted); font-size: 19rpx; line-height: 1.6; }
.planb-label { flex-shrink: 0; color: var(--sage-deep); font-weight: 800; }
.planb-text { flex: 1; min-width: 0; }
.tip-row, .rule-row, .faq-row { display: flex; align-items: flex-start; gap: 13rpx; padding: 16rpx 0; border-bottom: 2rpx solid var(--line); color: var(--muted); font-size: 19rpx; line-height: 1.65; }
.tip-row:last-child, .rule-row:last-child, .faq-row:last-child { border-bottom: 0; }
.tip-no { width: 31rpx; height: 31rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--ink); color: #fff; font-size: 16rpx; }
.rule-row, .faq-row { display: block; }
.rule-title, .faq-q { display: block; color: var(--ink); font-size: 20rpx; font-weight: 800; }
.rule-desc, .faq-a { display: block; margin-top: 5rpx; color: var(--muted); }
.diary-card { padding: 25rpx; border-radius: 22rpx; background: linear-gradient(145deg, var(--paper), #edf4e5); color: var(--ink); font-family: "Noto Serif SC", "Songti SC", serif; font-size: 21rpx; line-height: 1.8; white-space: pre-wrap; }
.diary-by { display: block; margin-top: 15rpx; color: var(--sage-deep); text-align: right; font-size: 17rpx; }
.diary-btn, .checkin-btn { width: 100%; height: 84rpx; margin: 15rpx 0 0; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; font-size: 22rpx; font-weight: 700; line-height: 1; }
.diary-btn { border: 2rpx solid var(--sage); background: var(--paper); color: var(--sage-deep); }
.checkin-btn { margin-top: 26rpx; border: 0; background: var(--ink); color: #fff; }
