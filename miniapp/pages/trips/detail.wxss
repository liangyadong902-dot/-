.page-shell{min-height:100vh;background:var(--cream);padding-bottom:70rpx}.head{padding:88rpx 34rpx 40rpx;background:linear-gradient(180deg,#e3edd6,var(--cream))}.kicker{display:block;color:var(--sage-deep);font-size:18rpx;letter-spacing:.16em}.title{display:block;margin-top:12rpx;font:900 46rpx/1.2 serif}.desc{display:block;margin-top:10rpx;color:var(--muted);font-size:22rpx}.content{padding:24rpx 28rpx}.hero-card,.section{background:var(--paper);border:1rpx solid var(--line);border-radius:20rpx;padding:28rpx}.hero-card{background:linear-gradient(145deg,#fffdf8,#edf4e5)}.badge{display:inline-block;padding:8rpx 16rpx;border-radius:999rpx;background:var(--sage);color:#fff;font-size:19rpx}.mood{display:block;margin-top:28rpx;font:800 32rpx/1.35 serif}.highlight{display:block;margin-top:12rpx;color:var(--muted);font-size:22rpx;line-height:1.65}.metrics{display:flex;gap:22rpx;margin-top:28rpx}.metrics view{flex:1}.metrics text,.metrics strong{display:block}.metrics text{color:var(--muted);font-size:18rpx}.metrics strong{margin-top:6rpx;font-size:24rpx}.section{margin-top:18rpx}.section-title{font-weight:800;font-size:25rpx}.chips{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.chip{padding:8rpx 14rpx;border-radius:999rpx;background:var(--sage-mist);color:var(--sage-deep);font-size:19rpx}.diary text{display:block;margin-top:14rpx;color:var(--muted);font-size:21rpx;line-height:1.7;white-space:pre-wrap}.actions{display:flex;gap:14rpx;margin-top:22rpx}.actions button{flex:1;height:76rpx;border-radius:999rpx;font-size:23rpx}.sage{background:var(--sage);border:1rpx solid var(--sage);color:#fff}.ghost,.diary-btn{background:var(--paper);border:1rpx solid var(--line);color:var(--ink)}.diary-btn{width:100%;height:70rpx;border-radius:999rpx;margin-top:14rpx}.state{min-height:48vh;display:grid;place-items:center;color:var(--muted)}
