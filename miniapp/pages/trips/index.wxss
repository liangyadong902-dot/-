.ticket-card {
  display: block;
}

.ticket-main {
  display: flex;
  min-height: 207.69rpx;
}

.ticket-card .ticket-main > image {
  width: 200rpx;
  height: 207.69rpx;
}

.ticket-body {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.ticket-foot {
  gap: 12rpx;
}

.ticket-route-preview {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  padding: 23rpx 23rpx 17rpx;
  border-top: 2rpx dashed var(--line);
}

.ticket-route-preview::before {
  content: "";
  position: absolute;
  left: 17%;
  right: 17%;
  top: 34rpx;
  height: 2rpx;
  background: var(--sage-soft);
}

.ticket-route-node {
  position: relative;
  z-index: 1;
  min-width: 0;
  text-align: center;
}

.route-dot {
  width: 18rpx;
  height: 18rpx;
  margin: 0 auto 12rpx;
  border: 4rpx solid var(--sage-deep);
  border-radius: 50%;
  background: var(--paper);
}

.ticket-route-node.first .route-dot {
  background: var(--sage-deep);
}

.route-name,
.route-time {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.route-name {
  color: var(--ink);
  font-size: 18rpx;
  font-weight: 700;
}

.route-time {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 16rpx;
}

.ticket-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15rpx;
  padding: 4rpx 23rpx 23rpx;
}

.ticket-actions button {
  width: 100%;
  height: 84rpx;
  min-height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1;
}

.route-btn {
  border: 2rpx solid var(--ink);
  background: var(--paper);
  color: var(--ink);
}

.guide-btn {
  border: 2rpx solid var(--sage);
  background: var(--sage);
  color: #fff;
}
