<view class="page-shell"><view class="head"><text class="kicker">TRIP SNAPSHOT</text><text class="title">{{trip ? trip.routeName : '行程详情'}}</text><text class="desc">{{trip ? trip.location : ''}}</text></view><view wx:if="{{loading}}" class="state">正在打开行程…</view><view wx:elif="{{error}}" class="state">{{error}}</view><view wx:else class="content"><view class="hero-card"><view class="badge">{{trip.badgeName || '旅程徽章'}}</view><text class="mood">{{trip.moodText || '把今天交给风景'}}</text><text class="highlight">{{trip.highlight || '一条刚刚好的路线，等你慢慢走完。'}}</text><view class="metrics"><view><text>购入</text><strong>¥{{trip.priceText}}</strong></view><view><text>票面</text><strong>¥{{trip.valueText}}</strong></view><view><text>状态</text><strong>{{trip.validityText}}</strong></view></view></view><view class="section"><view class="section-title">随盒包含</view><view class="chips"><text wx:for="{{trip.includeList}}" wx:key="*this" class="chip">{{item}}</text></view></view><view wx:if="{{trip.diaryText}}" class="section diary"><view class="section-title">AI 日记</view><text>{{trip.diaryText}}</text></view><view class="actions"><button class="sage" bindtap="openGuide">查看完整攻略</button><button wx:if="{{trip.validity === 'valid'}}" class="ghost" bindtap="openCheckin">去打卡</button></view><button class="diary-btn" bindtap="diary">{{diaryLoading ? '正在生成…' : (trip.diaryText ? '重新读取日记' : '生成 AI 日记')}}</button></view></view>
