.page-shell{min-height:100vh;background:var(--cream);padding-bottom:60rpx}.head{padding:88rpx 34rpx 34rpx;background:linear-gradient(180deg,#e3edd6,var(--cream))}.kicker{display:block;color:var(--sage-deep);font-size:18rpx;letter-spacing:.16em}.title{display:block;margin-top:12rpx;font:900 48rpx/1.15 serif}.desc{display:block;margin-top:12rpx;color:var(--muted);font-size:21rpx}.tabs{padding:22rpx 30rpx;white-space:nowrap}.tab{display:inline-block;margin-right:16rpx;padding:12rpx 24rpx;border:1rpx solid var(--line);border-radius:999rpx;background:var(--paper);color:var(--muted);font-size:21rpx}.tab.active{background:var(--sage-mist);border-color:var(--sage);color:var(--sage-deep);font-weight:700}.list{padding:0 28rpx}.order-card{margin-bottom:18rpx;padding:24rpx;background:var(--paper);border:1rpx solid var(--line);border-radius:18rpx;box-shadow:0 8rpx 20rpx rgba(60,52,44,.05)}.row{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.name{font-weight:800;font-size:27rpx}.status{color:var(--sage-deep);font-size:21rpx}.meta{margin-top:12rpx;color:var(--muted);font-size:19rpx}.foot{margin-top:24rpx;color:var(--muted);font-size:19rpx}.price{color:var(--ink);font-weight:800;font-size:28rpx}.state{min-height:48vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22rpx;color:var(--muted);font-size:23rpx}.ghost,.sage{border:1rpx solid var(--line);border-radius:999rpx;padding:0 30rpx;height:72rpx;font-size:22rpx}.sage{background:var(--sage);border-color:var(--sage);color:#fff}
