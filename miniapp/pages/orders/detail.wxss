.page-shell{min-height:100vh;background:var(--cream);padding-bottom:60rpx}.head{padding:88rpx 34rpx 34rpx;background:linear-gradient(180deg,#F7F7F7,var(--cream))}.kicker{display:block;color:var(--sage-deep);font-size:18rpx;letter-spacing:.16em}.title{display:block;margin-top:12rpx;font:900 48rpx/1.15 serif}.desc{display:block;margin-top:12rpx;color:var(--muted);font-size:20rpx}.content{padding:26rpx 28rpx}.ticket{padding:28rpx;background:var(--paper);border:1rpx solid var(--line);border-radius:20rpx}.row,.line{display:flex;justify-content:space-between;align-items:center;gap:20rpx}.name{font-size:30rpx;font-weight:800}.status{color:var(--sage-deep)}.line{margin-top:22rpx;color:var(--muted);font-size:21rpx}.price{color:var(--ink);font-size:30rpx;font-weight:800}.route{margin-top:26rpx;padding-top:24rpx;border-top:1rpx dashed var(--line)}.route-title{display:block;font:800 29rpx/1.3 serif}.route-sub{display:block;margin-top:8rpx;color:var(--muted);font-size:20rpx}.actions{display:flex;gap:16rpx;margin-top:24rpx}.actions button{flex:1;height:76rpx;border-radius:999rpx;font-size:23rpx}.sage{background:var(--sage);border:1rpx solid var(--sage-deep);color:#fff}.ghost{background:var(--paper);border:1rpx solid var(--line);color:var(--ink)}.state{min-height:50vh;display:grid;place-items:center;color:var(--muted)}.drawing{margin-top:20rpx;padding:24rpx;background:var(--sage-mist);border-radius:16rpx;color:var(--sage-deep);font-size:21rpx;display:flex;align-items:center;gap:16rpx}.spinner{width:30rpx;height:30rpx;border:4rpx solid rgba(108,126,88,.25);border-top-color:var(--sage-deep);border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}

.order-unbox-mask{position:fixed;inset:0;z-index:80;display:flex;align-items:center;justify-content:center;padding:30rpx;background:rgba(31,27,20,.62);backdrop-filter:blur(10rpx)}
.order-unbox-card{width:100%;max-width:680rpx;min-height:690rpx;padding:34rpx 30rpx 42rpx;border:2rpx solid rgba(255,255,255,.55);border-radius:36rpx;background:var(--cream);box-shadow:0 30rpx 80rpx rgba(31,27,20,.3);overflow:hidden}
.order-unbox-card .unbox-drawing{padding-top:0}
.order-unbox-card .unbox-scene{height:440rpx}
.unbox-result{padding:42rpx 20rpx 12rpx;text-align:center}
.result-kicker{color:var(--sage-deep);font-size:18rpx;font-weight:800;letter-spacing:.18em}
.result-mark{width:108rpx;height:108rpx;margin:28rpx auto 24rpx;display:flex;align-items:center;justify-content:center;border:3rpx solid var(--ink);border-radius:50%;background:var(--sage-mist);color:var(--sage-deep);font-size:58rpx;font-weight:900;box-shadow:8rpx 10rpx 0 rgba(60,52,44,.08)}
.result-title{font:900 42rpx/1.25 "Noto Serif SC","Songti SC",serif;color:var(--ink)}
.result-place{margin-top:16rpx;color:var(--muted);font-size:24rpx}
.result-value{display:inline-flex;margin:28rpx auto;padding:12rpx 22rpx;border-radius:999rpx;background:var(--sage-mist);color:var(--sage-deep);font-size:22rpx;font-weight:800}
.result-btn{width:100%;height:78rpx;margin-top:14rpx;border-radius:999rpx;font-size:23rpx}

/* 订单详情不是 overlay 组件，但复用同一套开盒视觉，因此在页面内保留完整动画样式。 */
.unbox-drawing{padding:12rpx 0 6rpx;text-align:center;overflow:hidden}
.unbox-scene{position:relative;height:440rpx;max-width:596rpx;margin:0 auto;perspective:1346rpx}
.unbox-shadow{position:absolute;left:50%;bottom:46rpx;width:288rpx;height:29rpx;transform:translateX(-50%);border-radius:50%;background:rgba(60,52,44,.13);filter:blur(10rpx)}
.unbox-base{position:absolute;left:50%;bottom:67rpx;width:242rpx;height:177rpx;transform:translateX(-50%);background:var(--sage);border:4rpx solid var(--ink);border-radius:15rpx 15rpx 27rpx 27rpx;box-shadow:inset 0 -17rpx 0 rgba(60,52,44,.08),0 19rpx 35rpx rgba(60,52,44,.13)}
.unbox-base::before{content:'';position:absolute;left:106rpx;top:0;bottom:0;width:27rpx;background:var(--cream-2);border-left:3rpx solid var(--ink);border-right:3rpx solid var(--ink)}
.base-brand{position:absolute;left:0;right:0;bottom:19rpx;color:#fff;font:900 19rpx/1.2 "Noto Serif SC","Songti SC",serif;letter-spacing:.08em}
.unbox-lid{position:absolute;left:50%;bottom:229rpx;z-index:5;width:273rpx;height:58rpx;transform:translateX(-50%);transform-origin:35rpx 50rpx;background:var(--sage-soft);border:4rpx solid var(--ink);border-radius:15rpx 15rpx 10rpx 10rpx}
.unbox-lid::before{content:'';position:absolute;left:119rpx;top:-4rpx;width:27rpx;height:58rpx;background:var(--cream-2);border-left:3rpx solid var(--ink);border-right:3rpx solid var(--ink)}
.unbox-ticket{position:absolute;left:50%;bottom:129rpx;z-index:3;width:181rpx;height:227rpx;padding:23rpx 15rpx;transform:translateX(-50%) translateY(112rpx) rotate(-2deg);opacity:0;background:var(--paper);border:3rpx solid var(--ink);border-radius:15rpx;box-shadow:8rpx 12rpx 0 rgba(60,52,44,.1)}
.unbox-ticket::after{content:'';position:absolute;left:19rpx;right:19rpx;top:71rpx;border-top:2rpx dashed var(--sage)}
.ticket-b{display:block;margin-top:52rpx;color:var(--sage-deep);font:700 27rpx/1.2 "Noto Serif SC","Songti SC",serif}
.ticket-sm{display:block;margin-top:12rpx;color:var(--muted);font-size:15rpx;letter-spacing:.08em}
.unbox-rays view{position:absolute;left:50%;bottom:235rpx;width:4rpx;height:88rpx;background:var(--sage);transform-origin:50% 135rpx;opacity:0}
.unbox-rays view:nth-child(1){transform:rotate(-68deg)}.unbox-rays view:nth-child(2){transform:rotate(-43deg)}.unbox-rays view:nth-child(3){transform:rotate(-20deg)}.unbox-rays view:nth-child(4){transform:rotate(20deg)}.unbox-rays view:nth-child(5){transform:rotate(43deg)}.unbox-rays view:nth-child(6){transform:rotate(68deg)}
.unbox-confetti view{position:absolute;left:50%;top:138rpx;width:13rpx;height:25rpx;border-radius:4rpx;opacity:0}.unbox-confetti view:nth-child(1){margin-left:-177rpx;background:var(--blush)}.unbox-confetti view:nth-child(2){margin-left:-106rpx;background:var(--sage)}.unbox-confetti view:nth-child(3){margin-left:-35rpx;background:#D7B86B}.unbox-confetti view:nth-child(4){margin-left:52rpx;background:var(--sage-soft)}.unbox-confetti view:nth-child(5){margin-left:123rpx;background:var(--blush)}.unbox-confetti view:nth-child(6){margin-left:181rpx;background:#D7B86B}
.animating .unbox-base{animation:orderUnboxShake .7s ease .12s both,orderUnboxSettle .45s ease 2.1s both}.animating .unbox-lid{animation:orderLidOpen 1s cubic-bezier(.2,.8,.2,1) .72s both}.animating .unbox-ticket{animation:orderTicketReveal 1.35s cubic-bezier(.16,1,.3,1) 1.08s both}.animating .unbox-rays view{animation:orderRayFlash .9s ease 1.05s both}.animating .unbox-confetti view:nth-child(odd){animation:orderConfettiLeft 1.5s ease-out .9s both}.animating .unbox-confetti view:nth-child(even){animation:orderConfettiRight 1.5s ease-out .96s both}
.draw-title{font:700 33rpx/1.2 "Noto Serif SC","Songti SC",serif}.draw-status{min-height:35rpx;margin-top:10rpx;color:var(--muted);font-size:20rpx}.draw-progress{width:346rpx;height:8rpx;margin:21rpx auto 0;border-radius:99rpx;overflow:hidden;background:var(--line)}.draw-progress-bar{display:block;width:0;height:100%;border-radius:99rpx;background:var(--sage-deep);animation:orderDrawProgress 2.8s linear both}
@keyframes orderUnboxShake{0%,100%{transform:translateX(-50%) rotate(0)}20%{transform:translateX(-50%) rotate(-4deg)}40%{transform:translateX(-50%) rotate(4deg)}60%{transform:translateX(-50%) rotate(-3deg)}80%{transform:translateX(-50%) rotate(3deg)}}
@keyframes orderUnboxSettle{50%{transform:translateX(-50%) translateY(-12rpx)}100%{transform:translateX(-50%) translateY(0)}}
@keyframes orderLidOpen{0%{transform:translateX(-50%) rotate(0)}55%{transform:translateX(-50%) translateY(-92rpx) rotate(-13deg)}100%{transform:translateX(-50%) translate(-123rpx,-106rpx) rotate(-28deg)}}
@keyframes orderTicketReveal{0%{transform:translateX(-50%) translateY(112rpx) rotate(-2deg);opacity:0}35%{opacity:1}75%{transform:translateX(-50%) translateY(-52rpx) rotate(2deg);opacity:1}100%{transform:translateX(-50%) translateY(-38rpx) rotate(0);opacity:1}}
@keyframes orderRayFlash{0%{opacity:0;height:15rpx}45%{opacity:.8;height:88rpx}100%{opacity:0;height:112rpx}}
@keyframes orderConfettiLeft{0%{opacity:0;transform:translate(0,38rpx) rotate(0)}20%{opacity:1}100%{opacity:0;transform:translate(-65rpx,227rpx) rotate(230deg)}}
@keyframes orderConfettiRight{0%{opacity:0;transform:translate(0,38rpx) rotate(0)}20%{opacity:1}100%{opacity:0;transform:translate(58rpx,235rpx) rotate(-250deg)}}
@keyframes orderDrawProgress{to{width:100%}}
.reveal-in{animation:orderResultReveal .55s cubic-bezier(.16,1,.3,1) both}@keyframes orderResultReveal{from{opacity:0;transform:translateY(27rpx) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
