.page-shell{min-height:100vh;background:var(--cream);padding-bottom:60rpx}.head{padding:88rpx 34rpx 34rpx;background:linear-gradient(180deg,#e3edd6,var(--cream))}.kicker{display:block;color:var(--sage-deep);font-size:18rpx;letter-spacing:.16em}.title{display:block;margin-top:12rpx;font:900 48rpx/1.15 serif}.desc{display:block;margin-top:12rpx;color:var(--muted);font-size:20rpx}.content{padding:26rpx 28rpx}.ticket{padding:28rpx;background:var(--paper);border:1rpx solid var(--line);border-radius:20rpx}.row,.line{display:flex;justify-content:space-between;align-items:center;gap:20rpx}.name{font-size:30rpx;font-weight:800}.status{color:var(--sage-deep)}.line{margin-top:22rpx;color:var(--muted);font-size:21rpx}.price{color:var(--ink);font-size:30rpx;font-weight:800}.route{margin-top:26rpx;padding-top:24rpx;border-top:1rpx dashed var(--line)}.route-title{display:block;font:800 29rpx/1.3 serif}.route-sub{display:block;margin-top:8rpx;color:var(--muted);font-size:20rpx}.actions{display:flex;gap:16rpx;margin-top:24rpx}.actions button{flex:1;height:76rpx;border-radius:999rpx;font-size:23rpx}.sage{background:var(--sage);border:1rpx solid var(--sage);color:#fff}.ghost{background:var(--paper);border:1rpx solid var(--line);color:var(--ink)}.state{min-height:50vh;display:grid;place-items:center;color:var(--muted)}.drawing{margin-top:20rpx;padding:24rpx;background:var(--sage-mist);border-radius:16rpx;color:var(--sage-deep);font-size:21rpx;display:flex;align-items:center;gap:16rpx}.spinner{width:30rpx;height:30rpx;border:4rpx solid rgba(108,126,88,.25);border-top-color:var(--sage-deep);border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}

.payment-mask{position:fixed;inset:0;background:rgba(31,27,20,.55);display:flex;align-items:center;justify-content:center;z-index:60}.payment-panel{width:600rpx;background:var(--paper);border-radius:24rpx;padding:34rpx;display:flex;flex-direction:column;gap:18rpx}.payment-title{font:900 32rpx/1.2 serif}.payment-tip{color:var(--muted);font-size:21rpx;line-height:1.6}.payment-qr{width:360rpx;height:360rpx;margin:0 auto;background:#fff;border:1rpx solid var(--line);border-radius:12rpx}.payment-warning{color:#b3541e;font-size:20rpx}.payment-panel button{height:72rpx;border-radius:999rpx;font-size:22rpx;line-height:72rpx}
