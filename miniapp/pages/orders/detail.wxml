<view class="page-shell">
  <view class="head">
    <text class="kicker">ORDER DETAIL</text>
    <text class="title">订单详情</text>
    <text class="desc">{{order ? order.orderNo : ''}}</text>
  </view>

  <view wx:if="{{loading}}" class="state">正在读取…</view>
  <view wx:elif="{{error}}" class="state">{{error}}</view>
  <view wx:else class="content">
    <view class="ticket">
      <view class="row">
        <text class="name">{{order.boxName}}</text>
        <text class="status">{{order.statusText}}</text>
      </view>
      <view class="line">
        <text>订单金额</text>
        <text class="price">¥{{order.amountText}}</text>
      </view>
      <view class="line">
        <text>下单时间</text>
        <text>{{order.createdAt || '—'}}</text>
      </view>
      <view class="line">
        <text>支付渠道</text>
        <text>{{order.payChannelText}}</text>
      </view>
      <view wx:if="{{order.routeName}}" class="route">
        <text class="route-title">{{order.routeName}}</text>
        <text class="route-sub">{{order.location}} · 票面价值 ¥{{order.routeValueText}}</text>
      </view>
    </view>

    <view wx:if="{{order.status === 'paid'}}" class="drawing">
      <view class="spinner"></view>
      <text>正在为你抽取路线，页面会自动刷新</text>
    </view>

    <view class="actions">
      <button wx:if="{{order.status === 'pending_pay'}}" class="sage" bindtap="pay">
        {{paying ? '模拟支付中…' : '模拟支付并开盒'}}
      </button>
      <button wx:if="{{order.status === 'pending_pay'}}" class="ghost" bindtap="cancel">取消订单</button>
      <button wx:if="{{order.status === 'opened'}}" class="sage" bindtap="openTrip">查看行程</button>
      <button wx:if="{{order.status === 'opened' && !order.refundNo}}" class="ghost" bindtap="openRefund">申请退款</button>

    </view>
  </view>

  <view wx:if="{{unboxVisible}}" class="order-unbox-mask" catchtouchmove="noop">
    <view class="order-unbox-card">
      <view wx:if="{{unboxStage === 'opening'}}" class="unbox-drawing animating">
        <view class="unbox-scene">
          <view class="unbox-rays"><view></view><view></view><view></view><view></view><view></view><view></view></view>
          <view class="unbox-confetti"><view></view><view></view><view></view><view></view><view></view><view></view></view>
          <view class="unbox-shadow"></view>
          <view class="unbox-ticket">
            <view class="ticket-sm">DESTINATION CARD</view>
            <view class="ticket-b">路线卡</view>
            <view class="ticket-sm">途个惊喜</view>
          </view>
          <view class="unbox-lid"></view>
          <view class="unbox-base"><view class="base-brand">途个惊喜</view></view>
        </view>
        <view class="draw-title">正在开启你的旅行盲盒</view>
        <view class="draw-status">{{unboxStatus}}</view>
        <view class="draw-progress"><view class="draw-progress-bar"></view></view>
      </view>
      <view wx:else class="unbox-result reveal-in">
        <view class="result-kicker">YOUR JOURNEY</view>
        <view class="result-mark">✓</view>
        <view class="result-title">{{order.routeName || '惊喜路线已解锁'}}</view>
        <view class="result-place">{{order.location || '新的旅途正在等你'}}</view>
        <view class="result-value">票面价值 ¥{{order.routeValueText}}</view>
        <button class="sage result-btn" bindtap="openTrip">查看我的行程</button>
        <button class="ghost result-btn" bindtap="closeUnbox">留在订单页</button>
      </view>
    </view>
  </view>
</view>
