<view class="page-shell"><view class="head"><text class="kicker">ORDER DETAIL</text><text class="title">订单详情</text><text class="desc">{{order ? order.orderNo : ''}}</text></view><view wx:if="{{loading}}" class="state">正在读取…</view><view wx:elif="{{error}}" class="state">{{error}}</view><view wx:else class="content"><view class="ticket"><view class="row"><text class="name">{{order.boxName}}</text><text class="status">{{order.statusText}}</text></view><view class="line"><text>订单金额</text><text class="price">¥{{order.amountText}}</text></view><view class="line"><text>下单时间</text><text>{{order.createdAt || '—'}}</text></view><view class="line"><text>支付渠道</text><text>{{order.payChannel || '待支付'}}</text></view><view wx:if="{{order.routeName}}" class="route"><text class="route-title">{{order.routeName}}</text><text class="route-sub">{{order.location}} · 票面价值 ¥{{order.routeValueText}}</text></view></view><view wx:if="{{order.status === 'paid'}}" class="drawing"><view class="spinner"></view><text>正在为你抽取路线，页面会自动刷新</text></view><view class="actions"><button wx:if="{{order.status === 'pending_pay'}}" class="sage" bindtap="pay">{{paying ? '处理中…' : '去支付'}}</button><button wx:if="{{order.status === 'pending_pay'}}" class="ghost" bindtap="cancel">取消订单</button><button wx:if="{{order.status === 'opened'}}" class="sage" bindtap="openTrip">查看行程</button><button wx:if="{{order.status === 'opened' && !order.refundNo}}" class="ghost" bindtap="openRefund">申请退款</button></view></view></view>
