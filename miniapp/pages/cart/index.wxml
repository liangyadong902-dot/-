<view class="page-shell"><view class="head"><text class="kicker">CART</text><text class="title">购物车</text><text class="desc">失效商品不会进入结算</text></view><view wx:if="{{loading}}" class="state">正在读取购物车…</view><view wx:elif="{{error}}" class="state"><text>{{error}}</text><button class="ghost" bindtap="load">重试</button></view><view wx:elif="{{!items.length}}" class="state"><text>购物车还是空的</text><button class="sage" bindtap="goMarket">去逛盲盒</button></view><view wx:else class="content"><view wx:for="{{items}}" wx:key="itemId" class="cart-row"><checkbox value="{{item.itemId}}" checked="{{item.selected !== false}}" data-id="{{item.itemId}}" bindchange="toggle"/><image src="{{item.box.coverUrl}}" mode="aspectFill"/><view class="copy"><text class="name">{{item.box.name}}</text><text class="muted">¥{{item.box.price}} × {{item.quantity}}</text><text wx:if="{{item.invalidReason}}" class="invalid">{{item.invalidReason}}</text></view><button class="remove" data-id="{{item.itemId}}" bindtap="remove">删除</button></view><view class="checkout"><view><text class="muted">合计</text><text class="total">¥{{totalText}}</text></view><button class="sage" bindtap="checkout">逐单结算</button></view></view></view>
