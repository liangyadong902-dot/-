.page-shell{min-height:100vh;background:var(--cream);padding-bottom:70rpx}.head{padding:88rpx 34rpx 40rpx;background:linear-gradient(180deg,#F7F7F7,var(--cream))}.kicker{display:block;color:var(--sage-deep);font-size:18rpx;letter-spacing:.16em}.title{display:block;margin-top:12rpx;font:900 46rpx/1.2 serif}.desc{display:block;margin-top:10rpx;color:var(--muted);font-size:21rpx}.content{padding:24rpx 28rpx}.cart-row{display:flex;align-items:center;gap:14rpx;padding:18rpx 0;border-bottom:1rpx solid var(--line)}.cart-row image{width:120rpx;height:120rpx;border-radius:14rpx;background:var(--sage-mist)}.copy{flex:1;min-width:0}.name,.muted,.invalid{display:block}.name{font-weight:800;font-size:24rpx}.muted{margin-top:8rpx;color:var(--muted);font-size:19rpx}.invalid{margin-top:8rpx;color:#a75e4b;font-size:18rpx}.remove{padding:0;border:0;background:transparent;color:var(--muted);font-size:19rpx}.checkout{display:flex;justify-content:space-between;align-items:center;margin-top:28rpx}.total{display:block;color:var(--ink);font-size:32rpx;font-weight:800;margin-top:4rpx}.sage,.ghost{height:72rpx;padding:0 28rpx;border-radius:999rpx;font-size:22rpx}.sage{background:var(--sage);border:1rpx solid var(--sage-deep);color:#fff}.ghost{border:1rpx solid var(--line);background:var(--paper)}.state{min-height:48vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;color:var(--muted)}
