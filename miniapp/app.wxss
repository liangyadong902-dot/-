    .page-inner {
      padding: 111.54rpx 34.62rpx 0;
      background: linear-gradient(180deg, #EAF1E0 0%, var(--cream) 107.69rpx);
      min-height: 100%;
    }

    .ai-stage {
      display: flex;
      flex-direction: column;
      flex: 1;
      height: 100%;
      min-height: 0;
    }
    .ai-body {
      flex: 1;
      min-height: 0;
      display: flex;
      align-items: stretch;
    }
    .ai-history {
      flex: 0 0 242.31rpx;
      width: 242.31rpx;
      min-height: 0;
      overflow: hidden;
      padding: 15.38rpx 11.54rpx 19.23rpx 19.23rpx;
      border-right: 1.92rpx dashed var(--line);
      background: linear-gradient(90deg, #E8F0DC 0%, rgba(232,240,220,0) 88%);
