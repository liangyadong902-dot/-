      align-items: center;
      gap: 9.62rpx;
      font-weight: 500;
      white-space: nowrap;
      flex-wrap: nowrap;
    }
    .slogan .heart { color: var(--sage); font-style: normal; }

    .mascot-col {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      width: 284.62rpx;
      flex-shrink: 0;
      margin-top: 0;
      overflow: visible;
    }
