      flex-direction: column;
      transition: flex-basis 0.28s cubic-bezier(.22,1,.36,1), width 0.28s cubic-bezier(.22,1,.36,1), padding 0.28s ease;
    }
    .ai-body.hist-collapsed .ai-history {
      flex-basis: 69.23rpx;
      width: 69.23rpx;
      padding: 15.38rpx 7.69rpx 19.23rpx;
      
    }
    .ai-history::-webkit-scrollbar { display: none; }
    .ai-hist-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 3.85rpx;
      min-height: 46.15rpx;
      margin-bottom: 15.38rpx;
    }
    .ai-body.hist-collapsed .ai-hist-head {
      flex-direction: column;
      justify-content: flex-start;
      margin-bottom: 0;
    }
    .ai-body.hist-collapsed .ai-hist-toggle { order: -1; }
    .ai-hist-label {
      font-size: 17.31rpx;
      letter-spacing: 0.16em;
