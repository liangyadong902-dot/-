      margin-top: 1.92rpx;
      flex-shrink: 0;
    }
    .slogan-heart {
      width: 21.15rpx;
      height: 21.15rpx;
      flex-shrink: 0;
    }
    .speech {
      background: var(--paper);
      border: 2.69rpx solid var(--ink);
      border-radius: 26.92rpx 26.92rpx 26.92rpx 7.69rpx;
      padding: 9.62rpx 19.23rpx;
      font-size: 19.23rpx;
      font-weight: 600;
      margin-bottom: 3.85rpx;
      white-space: nowrap;
      box-shadow: 3.85rpx 3.85rpx 0 rgba(60,52,44,0.06);
      position: relative;
    }

    /* 杂志式今日特选 */
    .special-block {
      display: grid;
      grid-template-columns: 1.18fr 0.92fr;
      gap: 19.23rpx;
      align-items: center;
      padding: 19.23rpx 34.62rpx 11.54rpx;
      position: relative;
      z-index: 1;
    }
    .special-photo {
      position: relative;
      min-width: 0;
      height: 269.23rpx;
      border-radius: 61.54rpx 46.15rpx 76.92rpx 38.46rpx;
