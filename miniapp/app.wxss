      font-size: 21.15rpx; font-weight: 700;
      font-family: inherit;
      flex-shrink: 0;
      white-space: nowrap;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      width: auto;
      min-width: 0;
      min-height: 0;
    }
