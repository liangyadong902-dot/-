      white-space: pre-line;
    }
    .fresh-orb {
      position: absolute;
      left: 15.38rpx; bottom: 15.38rpx;
      width: 96.15rpx; height: 96.15rpx;
      border-radius: 50%;
      background: var(--sage);
      color: #fff;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      font-size: 17.31rpx; font-weight: 700; line-height: 1.25;
      box-shadow: 0 7.69rpx 23.08rpx rgba(108,126,88,0.38);
      letter-spacing: 0.04em;
      z-index: 2;
