.tab-bar-root.is-hidden {
  height: 0;
  min-height: 0;
  max-height: 0;
  overflow: hidden;
  pointer-events: none;
  opacity: 0;
}
.tab-bar-root.is-hidden .bottom-tabbar {
  display: none;
}
.bottom-tabbar {
  position: relative;
  left: 0;
  width: 100%;
  /* 原型底栏总高为 72px（390px 画布），安全区只占内部留白，不能再叠加到总高。 */
  height: 138.46rpx;
  background: var(--paper, #FFFDF8);
  border-radius: 46.15rpx 46.15rpx 0 0;
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding: 15.38rpx 11.54rpx calc(38.46rpx + constant(safe-area-inset-bottom));
  padding: 15.38rpx 11.54rpx max(38.46rpx, env(safe-area-inset-bottom));
  box-shadow: 0 -15.38rpx 46.15rpx rgba(60, 52, 44, 0.06);
  box-sizing: border-box;
}
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5.77rpx;
  color: #C0B3A5;
  font-size: 19.23rpx;
  min-width: 107.69rpx;
  min-height: 84.62rpx;
}
.tab-icon-wrap {
  position: relative;
}
.tab-icon {
  width: 42.31rpx;
  height: 42.31rpx;
  display: block;
}
.tab-badge {
  position: absolute;
  top: -8rpx;
  left: 30rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  border-radius: 14rpx;
  background: #E05A5E;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(224, 90, 94, 0.4);
}
.tab-item.active { color: var(--sage-deep, #6C7E58); font-weight: 700; }
