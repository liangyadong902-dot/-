<Slide style={{ width: 1280, height: 720, background: '#F6F1E6', padding: '20px 64px', position: 'relative', overflow: 'hidden' }}>
    <Box style={{ position: 'absolute', top: -80, right: -60, width: 300, height: 190, borderRadius: '50%', background: '#E4EDD8', opacity: 0.45 }} />
    <Box style={{ position: 'absolute', bottom: -120, left: -80, width: 340, height: 210, borderRadius: '50%', background: '#EFE6D6', opacity: 0.5 }} />

    {/* A 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', position: 'relative', zIndex: 1 }}>
        <Box style={{ gap: 4, paddingBottom: 6 }}>
            <Text style={{ fontFamily: 'Caveat, cursive', fontSize: 17, fontWeight: 700, color: '#8EA47C', letterSpacing: 1 }}>05 · Solution</Text>
            <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 34, fontWeight: 900, color: '#3C342C' }}>解决方案</Text>
            <Box style={{ width: 56, height: 6, borderRadius: 3, background: '#8EA47C', marginTop: 6 }} />
        </Box>
        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 15, color: '#8F8376', width: 460, textAlign: 'right', lineHeight: 1.7, paddingBottom: 10 }}>
            把复杂的旅行规划，折叠成一次有回应的开盒。
        </Text>
    </Box>

    {/* B 内容区 */}
    <Box style={{ height: 520, position: 'relative', zIndex: 1, justifyContent: 'center', gap: 40 }}>
        <Text style={{ fontFamily: 'Caveat, cursive', fontSize: 22, fontWeight: 700, color: '#8EA47C' }}>How it works — 一次开盒的五步</Text>

        {/* 五步旅程轴 */}
        <Box style={{ flexDirection: 'row', alignItems: 'flex-start', justifyContent: 'space-between' }}>
            {[
                { n: '1', t: '选心情', d: '开心 / emo / 无聊 / 迷茫，先说心情，再说目的地' },
                { n: '2', t: '挑盲盒', d: '按分类浏览，几十秒做完决定' },
                { n: '3', t: '开惊喜', d: '随机解锁一条结构化路线' },
                { n: '4', t: '去旅行', d: '行程、徽章、日记一路沉淀' },
                { n: '5', t: '再回来', d: 'AI 搭子和兴趣同好把你留住' },
            ].map((item, idx) => (
                <Box key={idx} style={{ flexDirection: 'row', alignItems: 'flex-start' }}>
                    <Box style={{ alignItems: 'center', width: 190, gap: 12 }}>
                        <Box style={{
                            width: 64,
                            height: 64,
                            borderRadius: '50%',
                            background: 'linear-gradient(135deg, #8EA47C 0%, #6C7E58 100%)',
                            alignItems: 'center',
                            justifyContent: 'center',
                            boxShadow: '0 8px 18px rgba(108,126,88,0.3)',
                        }}>
                            <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 26, fontWeight: 900, color: '#FFFDF8' }}>{item.n}</Text>
                        </Box>
                        <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 20, fontWeight: 700, color: '#3C342C' }}>{item.t}</Text>
                        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, color: '#8F8376', lineHeight: 1.6, textAlign: 'center' }}>{item.d}</Text>
                    </Box>
                    {idx < 4 && (
                        <Box style={{ width: 30, height: 64, alignItems: 'center', justifyContent: 'center' }}>
                            <FAIcon name="arrow-right" style={{ fill: '#C9D6B8', width: 20, height: 20 }} />
                        </Box>
                    )}
                </Box>
            ))}
        </Box>

        {/* 底部做法条 */}
        <Box style={{
            height: 76,
            borderRadius: 16,
            background: 'linear-gradient(135deg, #8EA47C 0%, #6C7E58 100%)',
            flexDirection: 'row',
            alignItems: 'center',
            padding: '0 28px',
            gap: 18,
            boxShadow: '0 10px 24px rgba(108,126,88,0.26)',
        }}>
            <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 17, fontWeight: 700, color: '#FFFDF8' }}>我们的做法</Text>
            <Box style={{ width: 1, height: 28, background: 'rgba(255,253,248,0.4)' }} />
            <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 16, fontWeight: 500, color: '#FFFDF8', letterSpacing: 1 }}>
                盲盒轻量化 · 兴趣垂直化 · 视觉潮玩化 · 社交合规化
            </Text>
        </Box>
    </Box>

    {/* C 页脚 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E7DCCE', position: 'relative', zIndex: 1 }}>
        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, color: '#8F8376' }}>途个惊喜 · 随盒出发</Text>
        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, color: '#8F8376' }}>06 / 15</Text>
    </Box>
</Slide>
