<Slide style={{ width: 1280, height: 720, background: '#F6F1E6', padding: '20px 64px', position: 'relative', overflow: 'hidden' }}>
    <Box style={{ position: 'absolute', top: -80, right: -60, width: 300, height: 190, borderRadius: '50%', background: '#E4EDD8', opacity: 0.45 }} />
    <Box style={{ position: 'absolute', bottom: -120, left: -80, width: 340, height: 210, borderRadius: '50%', background: '#EFE6D6', opacity: 0.5 }} />

    {/* A 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', position: 'relative', zIndex: 1 }}>
        <Box style={{ gap: 4, paddingBottom: 6 }}>
            <Text style={{ fontFamily: 'Caveat, cursive', fontSize: 17, fontWeight: 700, color: '#8EA47C', letterSpacing: 1 }}>02 · Market</Text>
            <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 34, fontWeight: 900, color: '#3C342C' }}>市场空间</Text>
            <Box style={{ width: 56, height: 6, borderRadius: 3, background: '#8EA47C', marginTop: 6 }} />
        </Box>
        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 15, color: '#8F8376', width: 460, textAlign: 'right', lineHeight: 1.7, paddingBottom: 10 }}>
            市场容量来自高频年轻用户，政策支持来自文旅数字化与青年双创。
        </Text>
    </Box>

    {/* B 内容区 */}
    <Box style={{ height: 520, flexDirection: 'row', gap: 28, position: 'relative', zIndex: 1 }}>
        {/* 左：色块标题栏 */}
        <Box style={{
            width: '30%',
            borderRadius: 20,
            background: 'linear-gradient(160deg, #8EA47C 0%, #6C7E58 100%)',
            padding: 30,
            boxShadow: '0 12px 28px rgba(108,126,88,0.28)',
        }}>
            <Text style={{ fontFamily: 'Caveat, cursive', fontSize: 20, fontWeight: 700, color: 'rgba(255,253,248,0.85)', marginBottom: 16 }}>Four Drivers</Text>
            <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 30, fontWeight: 900, color: '#FFFDF8', lineHeight: 1.55 }}>
                四股力量，
                <br />
                把轻量化文旅
                <br />
                推到新的入口。
            </Text>
            <Box style={{ marginTop: 'auto' }}>
                <Box style={{ height: 1, background: 'rgba(255,253,248,0.35)', marginBottom: 16 }} />
                <Box style={{ background: 'rgba(255,253,248,0.16)', borderRadius: 999, padding: '5px 14px', alignSelf: 'flex-start', marginBottom: 12 }}>
                    <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, fontWeight: 600, color: '#FFFDF8' }}>切入口</Text>
                </Box>
                <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 14, color: 'rgba(255,253,248,0.9)', lineHeight: 1.8 }}>
                    用一款低决策成本的内容产品，先占住「周末去哪儿」的情绪入口。
                </Text>
            </Box>
        </Box>

        {/* 右：四象限 */}
        <Box style={{ flex: 1, flexDirection: 'row', flexWrap: 'wrap', gap: 20 }}>
            {[
                { tag: '亿级年轻用户', t: '用户基数', d: '18–32 岁年轻群体，是短途文旅的主力消费人群。', j: '人群基数大、决策高频，入口价值明确。' },
                { tag: '省心 + 惊喜', t: '需求增量', d: '「想出游、怕做攻略、怕踩雷、怕纠结」正在成为共性。', j: '痛点普遍且没被满足，新产品有真实空位。' },
                { tag: '轻资产可扩张', t: '复制空间', d: '纯线上内容产品，不受地域、季节和线下场地约束。', j: '边际成本低，跑通一个城市就能复制全国。' },
                { tag: '文旅 × 数字', t: '政策方向', d: '智慧文旅、数字文创、青年双创与网络合规形成支持面。', j: '方向顺势，项目申报与落地都有抓手。' },
            ].map((item, idx) => (
                <Box key={idx} style={{
                    width: '47%',
                    height: 250,
                    background: '#FFFDF8',
                    borderRadius: 18,
                    border: '1px solid #E7DCCE',
                    boxShadow: '0 4px 16px rgba(60,52,44,0.06)',
                    padding: 22,
                }}>
                    <Box style={{ background: '#E4EDD8', borderRadius: 999, padding: '4px 12px', alignSelf: 'flex-start', marginBottom: 12 }}>
                        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, fontWeight: 600, color: '#6C7E58' }}>{item.tag}</Text>
                    </Box>
                    <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 21, fontWeight: 700, color: '#3C342C', marginBottom: 8 }}>{item.t}</Text>
                    <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 14, color: '#8F8376', lineHeight: 1.65 }}>{item.d}</Text>
                    <Box style={{ marginTop: 'auto', borderLeft: '3px solid #8EA47C', paddingLeft: 10 }}>
                        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, fontWeight: 600, color: '#3C342C', lineHeight: 1.6 }}>{item.j}</Text>
                    </Box>
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 页脚 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E7DCCE', position: 'relative', zIndex: 1 }}>
        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, color: '#8F8376' }}>途个惊喜 · 随盒出发</Text>
        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, color: '#8F8376' }}>03 / 15</Text>
    </Box>
</Slide>
