<Slide style={{ width: 1280, height: 720, background: '#F6F1E6', padding: '20px 64px', position: 'relative', overflow: 'hidden' }}>
    <Box style={{ position: 'absolute', top: -80, right: -60, width: 300, height: 190, borderRadius: '50%', background: '#E4EDD8', opacity: 0.45 }} />
    <Box style={{ position: 'absolute', bottom: -120, left: -80, width: 340, height: 210, borderRadius: '50%', background: '#EFE6D6', opacity: 0.5 }} />

    {/* A 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', position: 'relative', zIndex: 1 }}>
        <Box style={{ gap: 4, paddingBottom: 6 }}>
            <Text style={{ fontFamily: 'Caveat, cursive', fontSize: 17, fontWeight: 700, color: '#8EA47C', letterSpacing: 1 }}>01 · Opportunity</Text>
            <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 34, fontWeight: 900, color: '#3C342C' }}>项目契机</Text>
            <Box style={{ width: 56, height: 6, borderRadius: 3, background: '#8EA47C', marginTop: 6 }} />
        </Box>
        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 15, color: '#8F8376', width: 460, textAlign: 'right', lineHeight: 1.7, paddingBottom: 10 }}>
            年轻人不是不想旅行，只是不想把旅行做成一份项目管理。
        </Text>
    </Box>

    {/* B 内容区 */}
    <Box style={{ height: 520, flexDirection: 'row', gap: 32, position: 'relative', zIndex: 1 }}>
        {/* 左：四个趋势 */}
        <Box style={{ width: '58%', background: '#FFFDF8', borderRadius: 20, border: '1px solid #E7DCCE', boxShadow: '0 4px 16px rgba(60,52,44,0.06)', padding: '8px 28px', justifyContent: 'space-between' }}>
            {[
                { n: '01', t: '轻量出行', d: '周末微度假、城市周边游，成了年轻人最高频的出行方式。' },
                { n: '02', t: '情绪价值', d: '他们想被治愈、被点亮，不想再被信息淹没。' },
                { n: '03', t: '兴趣匹配', d: '徒步、美食、拍照、放空——圈层需求越来越具体。' },
                { n: '04', t: '安全社交', d: '想结伴，但不想交换隐私，更不想被随机撮合。' },
            ].map((item, idx) => (
                <Box key={idx} style={{
                    flexDirection: 'row',
                    alignItems: 'center',
                    gap: 20,
                    height: 118,
                    borderBottom: idx < 3 ? '1px solid #E7DCCE' : 'none',
                }}>
                    <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 30, fontWeight: 900, color: '#C9D6B8', width: 52 }}>{item.n}</Text>
                    <Box style={{ gap: 6 }}>
                        <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 20, fontWeight: 700, color: '#3C342C' }}>{item.t}</Text>
                        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 15, color: '#8F8376', lineHeight: 1.6 }}>{item.d}</Text>
                    </Box>
                </Box>
            ))}
        </Box>

        {/* 右：行业判断 */}
        <Box style={{
            flex: 1,
            borderRadius: 20,
            background: 'linear-gradient(135deg, #8EA47C 0%, #6C7E58 100%)',
            padding: 30,
            boxShadow: '0 12px 28px rgba(108,126,88,0.28)',
        }}>
            <Text style={{ fontFamily: 'Caveat, cursive', fontSize: 20, fontWeight: 700, color: 'rgba(255,253,248,0.85)', marginBottom: 18 }}>Industry View</Text>
            <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 24, fontWeight: 700, color: '#FFFDF8', lineHeight: 1.7 }}>
                传统文旅是「大市场、高饱和」；
                <br />
                青年轻文旅是「需求增长、产品稀缺」。
            </Text>
            <Box style={{ width: 44, height: 4, borderRadius: 2, background: 'rgba(255,253,248,0.6)', marginTop: 22, marginBottom: 22 }} />
            <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 20, fontWeight: 900, color: '#FFFDF8', lineHeight: 1.6 }}>
                传统攻略的入口，正在失效。
            </Text>
            <Box style={{ marginTop: 'auto', paddingTop: 20 }}>
                <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 12, color: 'rgba(255,253,248,0.72)', lineHeight: 1.7 }}>
                    依据：项目组市场调研与项目契机材料；正式申报时可补充官方统计口径。
                </Text>
            </Box>
        </Box>
    </Box>

    {/* C 页脚 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E7DCCE', position: 'relative', zIndex: 1 }}>
        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, color: '#8F8376' }}>途个惊喜 · 随盒出发</Text>
        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, color: '#8F8376' }}>02 / 15</Text>
    </Box>
</Slide>
