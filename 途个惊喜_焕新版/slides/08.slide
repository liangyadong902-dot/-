<Slide style={{ width: 1280, height: 720, background: '#F6F1E6', padding: '20px 64px', position: 'relative', overflow: 'hidden' }}>
    <Box style={{ position: 'absolute', top: -80, right: -60, width: 300, height: 190, borderRadius: '50%', background: '#E4EDD8', opacity: 0.45 }} />
    <Box style={{ position: 'absolute', bottom: -120, left: -80, width: 340, height: 210, borderRadius: '50%', background: '#EFE6D6', opacity: 0.5 }} />

    {/* A 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', position: 'relative', zIndex: 1 }}>
        <Box style={{ gap: 4, paddingBottom: 6 }}>
            <Text style={{ fontFamily: 'Caveat, cursive', fontSize: 17, fontWeight: 700, color: '#8EA47C', letterSpacing: 1 }}>07 · Prototype</Text>
            <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 34, fontWeight: 900, color: '#3C342C' }}>原型体验</Text>
            <Box style={{ width: 56, height: 6, borderRadius: 3, background: '#8EA47C', marginTop: 6 }} />
        </Box>
        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 15, color: '#8F8376', width: 460, textAlign: 'right', lineHeight: 1.7, paddingBottom: 10 }}>
            用户看到的不是一张信息表，而是一种「打开它」的期待。
        </Text>
    </Box>

    {/* B 内容区 */}
    <Box style={{ height: 520, flexDirection: 'row', gap: 36, position: 'relative', zIndex: 1, alignItems: 'center' }}>
        {/* 左：三屏手机 */}
        <Box style={{ flexDirection: 'row', gap: 22 }}>
            {[
                { img: 'assets/proto_home.png', label: '首页 · 选心情，挑盲盒' },
                { img: 'assets/proto_ai.png', label: 'AI 搭子 · 把心情交给小途' },
                { img: 'assets/proto_badges.png', label: '图鉴 · 收集旅途印章' },
            ].map((item, idx) => (
                <Box key={idx} style={{ alignItems: 'center', gap: 14 }}>
                    <Box style={{
                        width: 178,
                        height: 386,
                        borderRadius: 22,
                        overflow: 'hidden',
                        border: '1px solid #E7DCCE',
                        boxShadow: '0 16px 32px rgba(60,52,44,0.14)',
                        background: '#FFFDF8',
                    }}>
                        <Image src={item.img} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
                    </Box>
                    <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, fontWeight: 600, color: '#6C7E58' }}>{item.label}</Text>
                </Box>
            ))}
        </Box>

        {/* 右：Web 端 + 视觉语言 */}
        <Box style={{ flex: 1, gap: 18 }}>
            <Box style={{
                width: '100%',
                height: 236,
                borderRadius: 16,
                overflow: 'hidden',
                border: '1px solid #E7DCCE',
                boxShadow: '0 12px 26px rgba(60,52,44,0.12)',
                background: '#FFFDF8',
            }}>
                <Image src="assets/web_home.png" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
            </Box>
            <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, fontWeight: 600, color: '#6C7E58' }}>Web 端 · 同一套语言</Text>
            <Box style={{ height: 1, background: '#E7DCCE' }} />
            <Text style={{ fontFamily: 'Noto Serif SC, serif', fontSize: 18, fontWeight: 700, color: '#3C342C' }}>视觉语言就是产品识别度</Text>
            <Box style={{ flexDirection: 'row', gap: 10, flexWrap: 'wrap' }}>
                {['奶油白', '鼠尾草绿', '纸张纹理', '杂志式排版'].map((tag, idx) => (
                    <Box key={idx} style={{ background: '#E4EDD8', borderRadius: 999, padding: '6px 16px' }}>
                        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, fontWeight: 600, color: '#6C7E58' }}>{tag}</Text>
                    </Box>
                ))}
            </Box>
            <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 14, color: '#8F8376', lineHeight: 1.75 }}>
                界面、文案和动效，都在为「打开它」的期待服务——这些不是装饰，是把旅行从工具感拉回到情绪体验。
            </Text>
        </Box>
    </Box>

    {/* C 页脚 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E7DCCE', position: 'relative', zIndex: 1 }}>
        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, color: '#8F8376' }}>途个惊喜 · 随盒出发</Text>
        <Text style={{ fontFamily: 'Noto Sans SC, sans-serif', fontSize: 13, color: '#8F8376' }}>08 / 15</Text>
    </Box>
</Slide>
